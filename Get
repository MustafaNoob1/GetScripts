warn("[AutoResearch] PC Scanner V1 START")

-- AUTOMATION RESEARCH SCANNER - PC V1
-- Read-only client scanner for your own Roblox game.
-- Searches client-visible scripts/modules/tables/UI/remotes for:
-- Points, Prestige, Power, Steel, Auto-buyers, Keycaps, Star Levels,
-- Space Points, Space Prestige, Dark Matter, Darkboard, Loops, Upgrades.
--
-- It DOES NOT fire remotes or modify game state.
--
-- Output:
--   AUTO_SCAN_Summary.txt
--   AUTO_SCAN_Matches.txt
--   AUTO_SCAN_Decompiled.txt
--   AUTO_SCAN_GC.txt
--   AUTO_SCAN_Remotes.txt
--   AUTO_SCAN_UI.txt

local S = {}
getgenv().AutomationResearchScanner = S

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local PlayerScripts = LocalPlayer:FindFirstChild("PlayerScripts")

S.Files = {
    Summary = "AUTO_SCAN_Summary.txt",
    Matches = "AUTO_SCAN_Matches.txt",
    Decompiled = "AUTO_SCAN_Decompiled.txt",
    GC = "AUTO_SCAN_GC.txt",
    Remotes = "AUTO_SCAN_Remotes.txt",
    UI = "AUTO_SCAN_UI.txt",
}

S.Keywords = {
    "points","prestige","power","steel",
    "auto buyer","autobuyer","auto-buy","auto buy",
    "keycap","keycaps","star level","starlevel",
    "space point","spacepoint","space prestige","spaceprestige",
    "dark matter","darkmatter","darkboard",
    "loop","loops","upgrade","upgrades",
    "multiplier","rebirth","currency","buy","purchase",
    "cost","price","requirement","unlock"
}

local function now()
    return os.date("!%Y-%m-%dT%H:%M:%SZ")
end

local function clip(v, n)
    local s = tostring(v or "")
    n = n or 2000
    if #s > n then
        return s:sub(1, n) .. "...<truncated>"
    end
    return s
end

local function norm(v)
    return string.lower(tostring(v or ""))
        :gsub("’", "'")
        :gsub("“", '"')
        :gsub("”", '"')
        :gsub("–", "-")
        :gsub("—", "-")
        :gsub("_", " ")
        :gsub("%s+", " ")
        :gsub("^%s+", "")
        :gsub("%s+$", "")
end

local function fullName(inst)
    local ok, result = pcall(function()
        return inst:GetFullName()
    end)
    return ok and tostring(result) or tostring(inst)
end

local function resetFile(name)
    if type(writefile) == "function" then
        pcall(writefile, name, "")
    end
end

local function append(name, ...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[i] = tostring(select(i, ...))
    end
    local line = table.concat(parts, " ") .. "\n"

    if type(appendfile) == "function" then
        local ok = pcall(appendfile, name, line)
        if ok then return end
    end

    local old = ""
    if type(readfile) == "function" and type(isfile) == "function" then
        pcall(function()
            if isfile(name) then
                old = readfile(name)
            end
        end)
    end

    if type(writefile) == "function" then
        pcall(writefile, name, old .. line)
    end
end

local function section(fileName, title)
    append(fileName, "")
    append(fileName, "============================================================")
    append(fileName, title)
    append(fileName, "============================================================")
end

local function serialize(value, depth, seen)
    depth = depth or 0
    seen = seen or {}

    if depth > 7 then
        return "<max-depth>"
    end

    local t = typeof(value)

    if t == "nil" then
        return "nil"
    elseif t == "string" then
        return string.format("%q", clip(value, 3500))
    elseif t == "number" or t == "boolean" then
        return tostring(value)
    elseif t == "Instance" then
        return "<Instance " .. fullName(value) .. ">"
    elseif t ~= "table" then
        return "<" .. t .. " " .. clip(value, 500) .. ">"
    end

    if seen[value] then
        return "<cycle>"
    end
    seen[value] = true

    local out = {}
    local count = 0

    for k, v in pairs(value) do
        count += 1
        if count > 450 then
            table.insert(out, "<table-capped>")
            break
        end
        table.insert(
            out,
            "[" .. serialize(k, depth + 1, seen) .. "]="
            .. serialize(v, depth + 1, seen)
        )
    end

    seen[value] = nil
    return "{" .. table.concat(out, ",") .. "}"
end

local function keywordHits(text)
    local n = norm(text)
    local hits = {}

    for _, keyword in ipairs(S.Keywords) do
        if string.find(n, keyword, 1, true) then
            table.insert(hits, keyword)
        end
    end

    return hits
end

local function scoreText(text)
    local hits = keywordHits(text)
    return #hits, hits
end

local function hitsText(hits)
    return #hits > 0 and table.concat(hits, ", ") or "-"
end

local function stage(name)
    warn("[AutoResearch] " .. tostring(name))
    append(S.Files.Summary, "[" .. now() .. "] STAGE " .. tostring(name))
    task.wait()
end

for _, fileName in pairs(S.Files) do
    resetFile(fileName)
end

section(S.Files.Summary, "AUTOMATION RESEARCH SCANNER - PC V1")
append(S.Files.Summary, "UTC:", now())
append(S.Files.Summary, "PlaceId:", game.PlaceId)
append(S.Files.Summary, "GameId:", game.GameId)
append(S.Files.Summary, "JobId:", game.JobId)
append(S.Files.Summary, "Player:", LocalPlayer and LocalPlayer.Name or "?")

local executor = "Unknown"
pcall(function()
    if type(identifyexecutor) == "function" then
        executor = tostring(select(1, identifyexecutor()) or "Unknown")
    end
end)
append(S.Files.Summary, "Executor:", executor)

section(S.Files.Summary, "CAPABILITIES")
for _, name in ipairs({
    "writefile","appendfile","readfile","isfile","getgc",
    "getloadedmodules","getscripts","getrunningscripts",
    "decompile","getconstants","getprotos","getupvalues","getconnections"
}) do
    append(S.Files.Summary, name, "=", tostring(type(getgenv()[name])))
end

stage("1/6 Collecting client-visible scripts")

local scriptList = {}
local scriptSeen = {}

local function addScript(inst, source)
    if typeof(inst) ~= "Instance" or not inst:IsA("LuaSourceContainer") then
        return
    end

    local path = fullName(inst)
    if scriptSeen[path] then return end

    scriptSeen[path] = true
    table.insert(scriptList, {
        Instance = inst,
        Path = path,
        Source = source,
    })
end

local roots = {
    {ReplicatedStorage, "ReplicatedStorage"},
    {StarterPlayer, "StarterPlayer"},
    {StarterGui, "StarterGui"},
    {Lighting, "Lighting"},
    {PlayerGui, "PlayerGui"},
}
if PlayerScripts then
    table.insert(roots, {PlayerScripts, "PlayerScripts"})
end

for _, item in ipairs(roots) do
    for index, object in ipairs(item[1]:GetDescendants()) do
        if object:IsA("LuaSourceContainer") then
            addScript(object, item[2])
        end
        if index % 1500 == 0 then task.wait() end
    end
end

if type(getloadedmodules) == "function" then
    local ok, modules = pcall(getloadedmodules)
    if ok and type(modules) == "table" then
        for index, inst in ipairs(modules) do
            addScript(inst, "getloadedmodules")
            if index % 500 == 0 then task.wait() end
        end
    end
end

for _, getterName in ipairs({"getrunningscripts", "getscripts"}) do
    local getter = getgenv()[getterName]
    if type(getter) == "function" then
        local ok, scripts = pcall(getter)
        if ok and type(scripts) == "table" then
            for index, inst in ipairs(scripts) do
                addScript(inst, getterName)
                if index % 500 == 0 then task.wait() end
            end
        end
    end
end

table.sort(scriptList, function(a, b)
    return a.Path < b.Path
end)

append(S.Files.Summary, "Unique scripts/modules:", #scriptList)

stage("2/6 Decompiling + scoring scripts")

section(S.Files.Decompiled, "DECOMPILED CLIENT SCRIPTS")
section(S.Files.Matches, "KEYWORD MATCHES")

local matchedScripts = 0
local decompiledCount = 0

for index, info in ipairs(scriptList) do
    local source = nil

    if type(decompile) == "function" then
        local ok, result = pcall(decompile, info.Instance)
        if ok and type(result) == "string" then
            source = result
            decompiledCount += 1
        end
    end

    local combined = info.Path .. "\n" .. tostring(info.Instance.Name)
        .. "\n" .. tostring(source or "")

    local score, hits = scoreText(combined)

    append(S.Files.Decompiled, "")
    append(S.Files.Decompiled, "------------------------------------------------------------")
    append(
        S.Files.Decompiled,
        "SCRIPT", index, "/", #scriptList,
        info.Path,
        "| source=" .. tostring(info.Source),
        "| keywordScore=" .. tostring(score),
        "| hits=" .. hitsText(hits)
    )
    append(S.Files.Decompiled, "------------------------------------------------------------")

    local attrs = {}
    pcall(function()
        attrs = info.Instance:GetAttributes()
    end)
    append(S.Files.Decompiled, "ATTRS=", serialize(attrs))

    if source then
        append(S.Files.Decompiled, source)
    else
        append(S.Files.Decompiled, "[decompile unavailable/failed]")
    end

    if score > 0 then
        matchedScripts += 1
        append(
            S.Files.Matches,
            "SCRIPT", matchedScripts,
            "score=" .. tostring(score),
            "hits=" .. hitsText(hits),
            "path=" .. info.Path,
            "source=" .. tostring(info.Source)
        )
    end

    task.wait()
end

append(S.Files.Summary, "Decompiled:", decompiledCount)
append(S.Files.Summary, "Matched scripts:", matchedScripts)

stage("3/6 Scanning remotes")

section(S.Files.Remotes, "REMOTE INVENTORY")
local remoteCount = 0
local remoteMatches = 0

for index, object in ipairs(ReplicatedStorage:GetDescendants()) do
    if object:IsA("RemoteEvent")
        or object:IsA("RemoteFunction")
        or object.ClassName == "UnreliableRemoteEvent" then

        remoteCount += 1
        local attrs = {}
        pcall(function()
            attrs = object:GetAttributes()
        end)

        local score, hits = scoreText(fullName(object) .. " " .. serialize(attrs))

        append(
            S.Files.Remotes,
            remoteCount,
            object.ClassName,
            fullName(object),
            "score=" .. tostring(score),
            "hits=" .. hitsText(hits),
            "attrs=" .. serialize(attrs)
        )

        if score > 0 then
            remoteMatches += 1
        end
    end

    if index % 1000 == 0 then task.wait() end
end

append(S.Files.Summary, "Remotes:", remoteCount)
append(S.Files.Summary, "Matched remotes:", remoteMatches)

stage("4/6 Scanning UI")

section(S.Files.UI, "UI MATCHES")
local uiMatches = 0

for index, object in ipairs(PlayerGui:GetDescendants()) do
    local text = nil
    if object:IsA("TextLabel")
        or object:IsA("TextButton")
        or object:IsA("TextBox") then
        text = object.Text
    end

    local blob = fullName(object)
        .. " " .. tostring(object.Name)
        .. " " .. tostring(text or "")

    local score, hits = scoreText(blob)

    if score > 0 then
        uiMatches += 1
        local extras = {}

        if object:IsA("GuiObject") then
            table.insert(extras, "Visible=" .. tostring(object.Visible))
            table.insert(extras, "AbsPos=" .. tostring(object.AbsolutePosition))
            table.insert(extras, "AbsSize=" .. tostring(object.AbsoluteSize))
        end

        if text then
            table.insert(extras, "Text=" .. string.format("%q", clip(text, 1500)))
        end

        append(
            S.Files.UI,
            "UI", uiMatches,
            "score=" .. tostring(score),
            "hits=" .. hitsText(hits),
            object.ClassName,
            fullName(object),
            table.concat(extras, " | ")
        )
    end

    if index % 600 == 0 then task.wait() end
end

append(S.Files.Summary, "Matched UI:", uiMatches)

stage("5/6 Scanning getgc tables")

section(S.Files.GC, "GETGC TABLE MATCHES")
local gcObjects = nil

if type(getgc) == "function" then
    local ok, result = pcall(getgc, true)
    if ok and type(result) == "table" then
        gcObjects = result
    end
end

local gcTableMatches = 0

if gcObjects then
    for index, object in ipairs(gcObjects) do
        if type(object) == "table" then
            local ok, result = pcall(serialize, object, 0, {})
            if ok and type(result) == "string" then
                local score, hits = scoreText(result)

                if score > 0 then
                    gcTableMatches += 1
                    append(
                        S.Files.GC,
                        "",
                        "GC TABLE", gcTableMatches,
                        "score=" .. tostring(score),
                        "hits=" .. hitsText(hits)
                    )
                    append(S.Files.GC, clip(result, 40000))
                end
            end
        end

        if index % 700 == 0 then task.wait() end
    end
end

append(S.Files.Summary, "Matched GC tables:", gcTableMatches)

stage("6/6 Scanning getgc function constants/upvalues")

section(S.Files.GC, "GETGC FUNCTION MATCHES")
local gcFunctionMatches = 0

if gcObjects then
    for index, object in ipairs(gcObjects) do
        if type(object) == "function" then
            local name = ""
            local sourcePath = ""

            if type(debug) == "table" and type(debug.info) == "function" then
                pcall(function()
                    name = tostring(debug.info(object, "n") or "")
                    sourcePath = tostring(debug.info(object, "s") or "")
                end)
            end

            local constants = nil
            local upvalues = nil

            if type(getconstants) == "function" then
                pcall(function()
                    constants = getconstants(object)
                end)
            end

            if type(getupvalues) == "function" then
                pcall(function()
                    upvalues = getupvalues(object)
                end)
            end

            local blob = name .. "\n" .. sourcePath .. "\n"
                .. (constants and serialize(constants) or "")
                .. "\n"
                .. (upvalues and serialize(upvalues) or "")

            local score, hits = scoreText(blob)

            if score > 0 then
                gcFunctionMatches += 1

                append(
                    S.Files.GC,
                    "",
                    "GC FUNCTION", gcFunctionMatches,
                    "score=" .. tostring(score),
                    "hits=" .. hitsText(hits),
                    "name=" .. name,
                    "source=" .. sourcePath
                )

                if constants then
                    append(S.Files.GC, "CONSTANTS=", clip(serialize(constants), 20000))
                end

                if upvalues then
                    append(S.Files.GC, "UPVALUES=", clip(serialize(upvalues), 30000))
                end
            end
        end

        if index % 450 == 0 then task.wait() end
    end
end

append(S.Files.Summary, "Matched GC functions:", gcFunctionMatches)

section(S.Files.Summary, "FINAL")
append(S.Files.Summary, "Scripts:", #scriptList)
append(S.Files.Summary, "Decompiled:", decompiledCount)
append(S.Files.Summary, "Matched scripts:", matchedScripts)
append(S.Files.Summary, "Remotes:", remoteCount)
append(S.Files.Summary, "Matched remotes:", remoteMatches)
append(S.Files.Summary, "Matched UI:", uiMatches)
append(S.Files.Summary, "Matched GC tables:", gcTableMatches)
append(S.Files.Summary, "Matched GC functions:", gcFunctionMatches)
append(S.Files.Summary, "Finished UTC:", now())

warn("[AutoResearch] PC Scanner V1 COMPLETE")
warn("[AutoResearch] Upload AUTO_SCAN_*.txt or zip them.")
