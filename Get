print("=== RATING GAME FINDER START ===")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local keywords = {
    "rating",
    "rate",
    "score",
    "grade",
    "rank",
    "quality",
    "result",
    "reward",
    "stars",
    "star",
    "judge",
    "judging",
    "performance",
    "perfect",
    "combo",
    "customer",
    "order",
    "recipe",
    "submit",
    "finish",
    "complete"
}

local function lower(value)
    return string.lower(tostring(value or ""))
end

local function containsKeyword(value)
    local s = lower(value)

    for _, keyword in ipairs(keywords) do
        if string.find(s, keyword, 1, true) then
            return true, keyword
        end
    end

    return false, nil
end

local output = {}
local function add(line)
    line = tostring(line or "")
    table.insert(output, line)
    print(line)
end

add("=== RATING GAME FINDER ===")
add("PlaceId: " .. tostring(game.PlaceId))
add("GameId: " .. tostring(game.GameId))
add("")

--------------------------------------------------
-- 1) REMOTES
--------------------------------------------------
add("==================================================")
add("REMOTE CANDIDATES")
add("==================================================")

local remoteCount = 0

for _, object in ipairs(ReplicatedStorage:GetDescendants()) do
    if object:IsA("RemoteEvent")
        or object:IsA("RemoteFunction")
        or object.ClassName == "UnreliableRemoteEvent" then

        local ok, keyword = containsKeyword(object.Name)

        if ok then
            remoteCount = remoteCount + 1

            add(
                tostring(remoteCount)
                .. ". "
                .. object.ClassName
                .. " | "
                .. object:GetFullName()
                .. " | keyword="
                .. tostring(keyword)
            )
        end
    end
end

add("")
add("Remote candidates: " .. tostring(remoteCount))
add("")

--------------------------------------------------
-- 2) LOADED MODULES BY NAME/PATH
--------------------------------------------------
add("==================================================")
add("MODULE CANDIDATES BY PATH")
add("==================================================")

local modules = {}
local moduleCandidates = {}

local okModules, moduleResult = pcall(function()
    return getloadedmodules()
end)

if okModules and type(moduleResult) == "table" then
    modules = moduleResult
else
    add("getloadedmodules failed: " .. tostring(moduleResult))
end

add("Loaded modules: " .. tostring(#modules))

for _, module in ipairs(modules) do
    local okPath, path = pcall(function()
        return module:GetFullName()
    end)

    if okPath then
        local found, keyword = containsKeyword(path)

        if found then
            table.insert(moduleCandidates, module)

            add(
                tostring(#moduleCandidates)
                .. ". "
                .. tostring(path)
                .. " | keyword="
                .. tostring(keyword)
            )
        end
    end
end

add("")
add("Path candidates: " .. tostring(#moduleCandidates))
add("")

--------------------------------------------------
-- 3) DECOMPILE PATH CANDIDATES
--------------------------------------------------
add("==================================================")
add("DECOMPILED PATH CANDIDATES")
add("==================================================")

local decompiledPaths = {}

for index, module in ipairs(moduleCandidates) do
    local path = tostring(module)

    pcall(function()
        path = module:GetFullName()
    end)

    if not decompiledPaths[path] then
        decompiledPaths[path] = true

        add("")
        add("--------------------------------------------------")
        add("MODULE " .. tostring(index) .. ": " .. path)
        add("--------------------------------------------------")

        local okSource, source = pcall(function()
            return decompile(module)
        end)

        if okSource and type(source) == "string" then
            add(source)
        else
            add("[DECOMPILE FAILED] " .. tostring(source))
        end

        task.wait()
    end
end

--------------------------------------------------
-- 4) BROAD MODULE SOURCE SCAN
-- Decompile loaded modules, but only save modules whose
-- source contains one of our rating/score keywords.
--------------------------------------------------
add("")
add("==================================================")
add("BROAD SOURCE MATCHES")
add("==================================================")

local broadMatches = 0

for index, module in ipairs(modules) do
    local path = tostring(module)

    pcall(function()
        path = module:GetFullName()
    end)

    if not decompiledPaths[path] then
        local okSource, source = pcall(function()
            return decompile(module)
        end)

        if okSource and type(source) == "string" then
            local found, keyword = containsKeyword(source)

            if found then
                broadMatches = broadMatches + 1

                add("")
                add("--------------------------------------------------")
                add(
                    "SOURCE MATCH "
                    .. tostring(broadMatches)
                    .. ": "
                    .. path
                    .. " | keyword="
                    .. tostring(keyword)
                )
                add("--------------------------------------------------")
                add(source)
            end
        end

        if index % 15 == 0 then
            task.wait()
        end
    end
end

add("")
add("Broad source matches: " .. tostring(broadMatches))
add("")

--------------------------------------------------
-- 5) GC TABLE HINTS
--------------------------------------------------
add("==================================================")
add("GC TABLE HINTS")
add("==================================================")

local gcMatches = 0

local okGc, gcObjects = pcall(function()
    return getgc(true)
end)

if okGc and type(gcObjects) == "table" then
    for _, object in ipairs(gcObjects) do
        if type(object) == "table" then
            local matchedKeys = {}

            local okTable = pcall(function()
                for key, value in pairs(object) do
                    local keyMatch = containsKeyword(key)
                    local valueMatch = false

                    if type(value) == "string" then
                        valueMatch = containsKeyword(value)
                    end

                    if keyMatch or valueMatch then
                        table.insert(
                            matchedKeys,
                            tostring(key) .. "=" .. tostring(value)
                        )

                        if #matchedKeys >= 15 then
                            break
                        end
                    end
                end
            end)

            if okTable and #matchedKeys > 0 then
                gcMatches = gcMatches + 1
                add("")
                add("GC TABLE " .. tostring(gcMatches))
                add(table.concat(matchedKeys, " | "))

                if gcMatches >= 100 then
                    add("GC table output capped at 100 matches.")
                    break
                end
            end
        end
    end
else
    add("getgc failed: " .. tostring(gcObjects))
end

add("")
add("GC matches: " .. tostring(gcMatches))
add("")

--------------------------------------------------
-- SAVE
--------------------------------------------------
local finalOutput = table.concat(output, "\n")

local saveOk, saveErr = pcall(function()
    writefile("Rating_Game_Modules.txt", finalOutput)
end)

print("SAVE:", saveOk, saveErr or "")
print("Output chars:", #finalOutput)
print("=== RATING GAME FINDER END ===")
