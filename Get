--------------------------------------------------
-- WORLD CLICK
--------------------------------------------------

UserInputService.InputBegan:Connect(
    function(input, processed)

        if processed then
            return
        end

        if not SelectMode then
            return
        end

        if input.UserInputType
            ~= Enum.UserInputType.MouseButton1 then

            return

        end

        local hit =
            raycastMouse()

        if not hit then

            Status.Text =
                "Keine Oberfläche getroffen"

            return

        end

        local right, up =
            makeBasis(hit.Normal)

        Selected = {

            Position =
                hit.Position,

            Normal =
                hit.Normal.Unit,

            Right =
                right,

            Up =
                up,

            Part =
                hit.Instance

        }

        SelectMode = false

        Status.Text =
            "✓ MSTJ Position gespeichert\n"
            .. hit.Instance.Name

        Status.TextColor3 =
            Color3.fromRGB(
                100,
                255,
                140
            )

        updatePreview()

    end
)

