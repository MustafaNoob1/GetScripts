warn("[CareerDeepFinder] START")

local out = {}
local function add(...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[i] = tostring(select(i, ...))
    end
    local line = table.concat(parts, " ")
    table.insert(out, line)
    print(line)
end

local function safePath(inst)
    local ok, path = pcall(function()
        return inst:GetFullName()
    end)
    return ok and path or tostring(inst)
end

local wanted = {
    "dayfoot",
    "career",
    "score",
    "point",
    "potential",
    "overall",
    "ballon",
    "troph",
    "leaderboard",
    "retire",
    "endcareer",
    "finishcareer"
}

local function relevant(text)
    local s = string.lower(tostring(text or ""))
    for _, key in ipairs(wanted) do
        if string.find(s, key, 1, true) then
            return true
        end
    end
    return false
end

local scripts = {}
local seen = {}

local function addScript(inst)
    if typeof(inst) ~= "Instance" then
        return
    end

    if not inst:IsA("LuaSourceContainer") then
        return
    end

    local path = safePath(inst)

    if seen[path] then
        return
    end

    if relevant(path) then
        seen[path] = true
        table.insert(scripts, inst)
    end
end

-- Executor APIs differ, so try all normal script enumerators.
for _, getterName in ipairs({"getrunningscripts", "getscripts"}) do
    local getter = getgenv()[getterName]

    if type(getter) == "function" then
        local ok, result = pcall(getter)

        add("ENUM", getterName, ok, type(result) == "table" and #result or "-")

        if ok and type(result) == "table" then
            for _, inst in ipairs(result) do
                addScript(inst)
            end
        end
    end
end

if type(getloadedmodules) == "function" then
    local ok, result = pcall(getloadedmodules)
    add("ENUM getloadedmodules", ok, type(result) == "table" and #result or "-")

    if ok and type(result) == "table" then
        for _, inst in ipairs(result) do
            addScript(inst)
        end
    end
end

-- Direct hierarchy scan catches LocalScripts even when the executor does not
-- expose them through getscripts().
for _, root in ipairs({
    game:GetService("Players").LocalPlayer:FindFirstChild("PlayerScripts"),
    game:GetService("ReplicatedStorage"):FindFirstChild("DayFoot")
}) do
    if root then
        for _, inst in ipairs(root:GetDescendants()) do
            addScript(inst)
        end
    end
end

add("")
add("SCRIPT CANDIDATES:", #scripts)

for i, inst in ipairs(scripts) do
    local path = safePath(inst)

    add("")
    add("============================================================")
    add("SCRIPT", i, path)
    add("============================================================")

    local ok, source = pcall(function()
        return decompile(inst)
    end)

    if ok and type(source) == "string" then
        add(source)
    else
        add("[DECOMPILE FAILED]", source)
    end

    task.wait()
end

-- GC scan: find live career-state tables and scoring-related functions.
add("")
add("============================================================")
add("GC CAREER STATE / FUNCTIONS")
add("============================================================")

if type(getgc) == "function" then
    local ok, objects = pcall(getgc, true)

    if ok and type(objects) == "table" then
        local tableCount = 0
        local fnCount = 0

        for _, object in ipairs(objects) do
            if type(object) == "table" then
                local hits = {}
                local score = 0

                pcall(function()
                    for key, value in pairs(object) do
                        local k = string.lower(tostring(key))

                        if k == "pot"
                            or k == "potential"
                            or k == "overall"
                            or k == "ovr"
                            or k == "peak"
                            or k == "peakovr"
                            or k == "points"
                            or k == "score"
                            or k == "careerpoints"
                            or k == "ballon"
                            or k == "ballons"
                            or k == "trophies"
                            or k == "goals"
                            or k == "assists"
                            or k == "caps"
                            or k == "season"
                            or k == "age"
                            or k == "money"
                            or k == "rep"
                            or k == "reputation" then

                            score = score + 1
                            if #hits < 30 then
                                table.insert(hits, tostring(key) .. "=" .. tostring(value))
                            end
                        end
                    end
                end)

                if score >= 5 then
                    tableCount = tableCount + 1
                    add("")
                    add("GC TABLE", tableCount, "score", score)
                    add(table.concat(hits, " | "))

                    if tableCount >= 80 then
                        add("GC table output capped.")
                        break
                    end
                end
            elseif type(object) == "function" and type(debug) == "table" then
                local infoOk, info = pcall(debug.info, object, "sn")

                if infoOk then
                    local desc = tostring(info or "")
                    if relevant(desc) then
                        fnCount = fnCount + 1
                        add("GC FUNCTION", fnCount, desc)
                    end
                end
            end
        end
    else
        add("getgc failed:", objects)
    end
end

local final = table.concat(out, "\n")
local ok, err = pcall(function()
    writefile("CareerScore_DeepDump.txt", final)
end)

add("SAVE", ok, err or "")
warn("[CareerDeepFinder] DONE")
