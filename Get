local function getRoot()
    local character = Player.Character
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function raycastMouse()
    local mousePosition = UserInputService:GetMouseLocation()
    local inset = GuiService:GetGuiInset()
    mousePosition = mousePosition - inset

    local ray = Camera:ViewportPointToRay(mousePosition.X, mousePosition.Y)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = false

    local ignore = { PreviewFolder }

    if Player.Character then
        table.insert(ignore, Player.Character)
    end

    local sprayPaint = Workspace:FindFirstChild("SprayPaint")
    if sprayPaint then
        table.insert(ignore, sprayPaint)
    end

    params.FilterDescendantsInstances = ignore

    return Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
end

local function makeBasis(normal)
    normal = normal.Unit

    local worldUp = Vector3.new(0, 1, 0)
    local right = worldUp:Cross(normal)

    if right.Magnitude < 0.01 then
        right = Camera.CFrame.RightVector
        right = right - normal * right:Dot(normal)
    end

    right = right.Unit
    local up = normal:Cross(right).Unit

    return right, up
end

local function getRotatedBasis()
    local angle = math.rad(Rotation)
    local c = math.cos(angle)
    local s = math.sin(angle)

    local right =
        Selected.Right * c
        + Selected.Up * s

    local up =
        Selected.Up * c
        - Selected.Right * s

    return right, up
end

local function toWorld(x, y, normalOffset)
    if not Selected then
        return nil
    end

    normalOffset = normalOffset or 0

    local right, up = getRotatedBasis()
    local width = BASE_WIDTH * Scale
    local height = BASE_HEIGHT * Scale

    return
        Selected.Position
        + right * (x * width)
        + up * (y * height)
        + Selected.Normal * normalOffset
end

local function pointHasSurface(point)
    if not Selected then
        return false
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = false

    local ignore = { PreviewFolder }

    if Player.Character then
        table.insert(ignore, Player.Character)
    end

    local sprayPaint = Workspace:FindFirstChild("SprayPaint")
    if sprayPaint then
        table.insert(ignore, sprayPaint)
    end

    params.FilterDescendantsInstances = ignore

    local result = Workspace:Raycast(
        point + Selected.Normal * 0.75,
        -Selected.Normal * 2.25,
        params
    )

    if not result then
        return false
    end

    if result.Normal:Dot(Selected.Normal) < 0.85 then
        return false
    end

    local planeDistance =
        math.abs(
            (result.Position - point):Dot(Selected.Normal)
        )

    if planeDistance > 0.45 then
        return false
    end

    return true
end

local function validateSelectedPosition()
    if not Selected then
        return false, "Erst eine Wand auswählen."
    end

    if not Selected.Part or not Selected.Part.Parent then
        return false, "Die ausgewählte Wand existiert nicht mehr."
    end

    local root = getRoot()
    if not root then
        return false, "HumanoidRootPart nicht gefunden."
    end

    local distance = (Selected.Position - root.Position).Magnitude
    if distance >= MAX_DRAW_RANGE then
        return false, string.format("Zu weit von der Wand entfernt: %.1f Studs", distance)
    end

    return true
end

