-- AUTOMATION DEEP MAPPER - PC V2
-- Read-only follow-up scanner for the automation project.
--
-- Why V2:
-- The first scan found the important controllers/remotes/UI, but Delta's
-- decompiler panicked on most game scripts. This mapper therefore extracts:
--   1) returned values from relevant ReplicatedStorage modules via require()
--   2) function constants/upvalues/protos inside those returned module tables
--   3) callback metadata/upvalues from relevant GUI buttons via getconnections()
--   4) getgc functions that DIRECTLY reference one of the game's remotes
--   5) DataTemplate / SettingsDataTemplate / Config / Formulas structures
--
-- It does NOT FireServer / InvokeServer / click buttons / buy upgrades.
--
-- Output:
--   AUTO_DEEP_Summary.txt
--   AUTO_DEEP_Config.txt
--   AUTO_DEEP_Connections.txt
--   AUTO_DEEP_RemoteRefs.txt
--   AUTO_DEEP_State.txt

local M = {}
getgenv().AutomationDeepMapper = M

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

M.Files = {
    Summary = "AUTO_DEEP_Summary.txt",
    Config = "AUTO_DEEP_Config.txt",
    Connections = "AUTO_DEEP_Connections.txt",
    RemoteRefs = "AUTO_DEEP_RemoteRefs.txt",
    State = "AUTO_DEEP_State.txt",
}

M.Keywords = {
    "point","prestige","power","steel","auto","buyer","keycap",
    "star","space","dark","loop","upgrade","nova","supernova",
    "gamma","buy","reset","rebirth","currency","cost","price",
}

local function norm(v)
    return string.lower(tostring(v or ""))
        :gsub("_", " ")
        :gsub("%s+", " ")
end

local function relevant(text)
    local n = norm(text)
    for _, word in ipairs(M.Keywords) do
        if string.find(n, word, 1, true) then
            return true
        end
    end
    return false
end

local function fullName(inst)
    local ok, result = pcall(function()
        return inst:GetFullName()
    end)
    return ok and tostring(result) or tostring(inst)
end

local function clip(v, n)
    local s = tostring(v or "")
    n = n or 4000
    if #s > n then
        return s:sub(1, n) .. "...<truncated>"
    end
    return s
end

local function serialize(value, depth, seen)
    depth = depth or 0
    seen = seen or {}

    if depth > 10 then
        return "<max-depth>"
    end

    local t = typeof(value)

    if t == "nil" then
        return "nil"
    elseif t == "string" then
        return string.format("%q", clip(value, 5000))
    elseif t == "number" or t == "boolean" then
        return tostring(value)
    elseif t == "Instance" then
        return "<Instance " .. fullName(value) .. ">"
    elseif t == "function" then
        local name, source = "", ""
        if type(debug) == "table" and type(debug.info) == "function" then
            pcall(function()
                name = tostring(debug.info(value, "n") or "")
                source = tostring(debug.info(value, "s") or "")
            end)
        end
        return "<function name=" .. name .. " source=" .. source .. ">"
    elseif t ~= "table" then
        return "<" .. t .. " " .. clip(value, 500) .. ">"
    end

    if seen[value] then
        return "<cycle>"
    end
    seen[value] = true

    local out = {}
    local count = 0

    for k, v in pairs(value) do
        count += 1
        if count > 1200 then
            table.insert(out, "<table-capped>")
            break
        end

        table.insert(
            out,
            "[" .. serialize(k, depth + 1, seen) .. "]="
            .. serialize(v, depth + 1, seen)
        )
    end

    seen[value] = nil
    return "{" .. table.concat(out, ",") .. "}"
end

local function resetFile(name)
    if type(writefile) == "function" then
        pcall(writefile, name, "")
    end
end

local function append(name, ...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[i] = tostring(select(i, ...))
    end
    local line = table.concat(parts, " ") .. "\n"

    if type(appendfile) == "function" then
        local ok = pcall(appendfile, name, line)
        if ok then return end
    end

    local old = ""
    if type(isfile) == "function"
        and type(readfile) == "function" then
        pcall(function()
            if isfile(name) then
                old = readfile(name)
            end
        end)
    end

    if type(writefile) == "function" then
        pcall(writefile, name, old .. line)
    end
end

local function section(file, title)
    append(file, "")
    append(file, "============================================================")
    append(file, title)
    append(file, "============================================================")
end

local function stage(name)
    warn("[AutoDeep] " .. name)
    append(M.Files.Summary, os.date("!%H:%M:%S"), name)
    task.wait()
end

for _, file in pairs(M.Files) do
    resetFile(file)
end

section(M.Files.Summary, "AUTOMATION DEEP MAPPER - PC V2")
append(M.Files.Summary, "PlaceId:", game.PlaceId)
append(M.Files.Summary, "GameId:", game.GameId)

