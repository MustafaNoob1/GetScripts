function BR.indexTranslations()
    local names = {
        "StringsDE",
        "StringsPT",
        "StringsES",
        "StringsFR",
        "StringsEvents"
    }

    local function walk(tbl, seen)
        if type(tbl) ~= "table" then
            return
        end

        seen = seen or {}
        if seen[tbl] then
            return
        end
        seen[tbl] = true

        for key, value in pairs(tbl) do
            if type(key) == "string" and type(value) == "string" then
                local translated = BR.norm(value)
                local english = BR.norm(key)

                if translated ~= "" and english ~= "" then
                    BR.TranslationIndex[translated] = english
                end
            elseif type(value) == "table" then
                walk(value, seen)
            end
        end
    end

    for _, name in ipairs(names) do
        local module = BR.DayFoot:FindFirstChild(name)

        if module and module:IsA("ModuleScript") then
            local ok, result = pcall(require, module)
            if ok and type(result) == "table" then
                walk(result, {})
            end
        end
    end
end

pcall(BR.indexTranslations)

function BR.resolveChoiceText(text)
    local key = BR.norm(text)
    local direct = BR.ChoiceIndex[key]

    if direct then
        return direct
    end

    local english = BR.TranslationIndex[key]
    if english then
        return BR.ChoiceIndex[english]
    end

    return nil
end

