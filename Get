function S.norm(v)
    local s = string.lower(tostring(v or ""))
    s = s:gsub("’", "'"):gsub("“", '"'):gsub("”", '"'):gsub("–", "-"):gsub("—", "-")
    s = s:gsub("<.->", " "):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    return s
end

function S.path(inst)
    local ok, v = pcall(function() return inst:GetFullName() end)
    return ok and tostring(v) or tostring(inst)
end

function S.ts()
    return os.date("!%Y-%m-%dT%H:%M:%SZ")
end

function S.clip(v, n)
    local s = tostring(v or "")
    n = n or 1000
    return #s > n and (s:sub(1, n) .. "...<truncated>") or s
end

function S.serialize(v, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if depth > 7 then return "<max-depth>" end
    local t = typeof(v)
    if t == "nil" then return "nil" end
    if t == "string" then return string.format("%q", S.clip(v, 1600)) end
    if t == "number" or t == "boolean" then return tostring(v) end
    if t == "Instance" then return "<Instance " .. S.path(v) .. ">" end
    if t ~= "table" then return "<" .. t .. " " .. S.clip(v, 200) .. ">" end
    if seen[v] then return "<cycle>" end
    seen[v] = true
    local out, c = {}, 0
    for k, x in pairs(v) do
        c += 1
        if c > 450 then table.insert(out, "<table capped>") break end
        table.insert(out, "[" .. S.serialize(k, depth+1, seen) .. "]=" .. S.serialize(x, depth+1, seen))
    end
    seen[v] = nil
    return "{" .. table.concat(out, ",") .. "}"
end

function S.write(name, data)
    if type(writefile) ~= "function" then return false end
    local ok, err = pcall(function() writefile(name, tostring(data or "")) end)
    if not ok then warn("[GOATScanner] write failed", name, err) end
    return ok
end

function S.log(kind, payload)
    local line = "[" .. S.ts() .. "][" .. tostring(kind) .. "] " .. tostring(payload or "")
    table.insert(S.Telemetry, line)
    S.TelemetryChars += #line + 1
    print("[GOATScanner]", kind, payload)
    if S.TelemetryChars > S.MaxTelemetryChars then
        local keep = {}
        for i = math.floor(#S.Telemetry/2), #S.Telemetry do table.insert(keep, S.Telemetry[i]) end
        S.Telemetry = keep
        S.TelemetryChars = #table.concat(keep, "\n")
    end
end

function S.flush()
    S.write("GOATScan_LiveTelemetry.txt", table.concat(S.Telemetry, "\n"))
    S.LastFlush = os.clock()
end

