--------------------------------------------------
-- RAYCAST
--------------------------------------------------

local function raycastMouse()

    local mousePosition =
        UserInputService:GetMouseLocation()

    local inset =
        GuiService:GetGuiInset()

    mousePosition =
        mousePosition - inset

    local ray =
        Camera:ViewportPointToRay(
            mousePosition.X,
            mousePosition.Y
        )

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    local ignore = {
        PreviewFolder
    }

    if Player.Character then
        table.insert(
            ignore,
            Player.Character
        )
    end

    local sprayFolder =
        Workspace:FindFirstChild(
            "SprayPaint"
        )

    if sprayFolder then
        table.insert(
            ignore,
            sprayFolder
        )
    end

    params.FilterDescendantsInstances =
        ignore

    params.RespectCanCollide = false

    return Workspace:Raycast(
        ray.Origin,
        ray.Direction * 500,
        params
    )

end

--------------------------------------------------
-- WALL BASIS
--------------------------------------------------

local function makeBasis(normal)

    normal = normal.Unit

    local worldUp =
        Vector3.new(0, 1, 0)

    local right =
        worldUp:Cross(normal)

    if right.Magnitude < 0.01 then

        right =
            Camera.CFrame.RightVector

        right =
            right
            - normal
            * right:Dot(normal)

    end

    right = right.Unit

    local up =
        normal:Cross(right).Unit

    return right, up

end

--------------------------------------------------
-- PREVIEW LINE
--------------------------------------------------

local function previewLine(a, b)

    local delta =
        b - a

    local length =
        delta.Magnitude

    if length < 0.001 then
        return
    end

    local part =
        Instance.new("Part")

    part.Name =
        "PreviewLine"

    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false

    part.Material =
        Enum.Material.Neon

    part.Color =
        Color3.fromRGB(
            80,
            255,
            130
        )

    part.Transparency = 0.15

    part.Size =
        Vector3.new(
            0.07,
            0.07,
            length
        )

    part.CFrame =
        CFrame.lookAt(
            (a + b) / 2,
            b
        )

    part.Parent =
        PreviewFolder

end

--------------------------------------------------
-- UPDATE PREVIEW
--------------------------------------------------

local function updatePreview()

    PreviewFolder:ClearAllChildren()

    if not Selected then
        return
    end

    local center =
        Selected.Position
        + Selected.Normal * 0.04

    local right =
        Selected.Right

    local up =
        Selected.Up

    local halfW =
        PreviewWidth / 2

    local halfH =
        PreviewHeight / 2

    local tl =
        center
        - right * halfW
        + up * halfH

    local tr =
        center
        + right * halfW
        + up * halfH

    local bl =
        center
        - right * halfW
        - up * halfH

    local br =
        center
        + right * halfW
        - up * halfH

    previewLine(tl, tr)
    previewLine(tr, br)
    previewLine(br, bl)
    previewLine(bl, tl)

end

