------------------------------------------------------------
-- SAFE GAMEPASS CHECK
------------------------------------------------------------

local function ownsFeature(
    attribute,
    passId
)

    if Player:GetAttribute(
        attribute
    ) == true then

        return true

    end

    local success,
        result =
        pcall(
            function()

                return MarketplaceService
                    :UserOwnsGamePassAsync(
                        Player.UserId,
                        passId
                    )

            end
        )

    if success then
        return result == true
    end

    return false

end


