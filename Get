function BR.statImpact(key, amount)
    amount = tonumber(amount) or 0
    local position = BR.currentPosition()
    local weights = BR.PositionWeights[position] or {}
    local weight = weights[key] or 0

    if key == "technique" then
        local total = (weights.tir or 0) + (weights.passe or 0) + (weights.dribble or 0)
        weight = total / 3
    elseif key == "physique" then
        local total = (weights.vitesse or 0) + (weights.puissance or 0) + (weights.defense or 0)
        weight = total / 3
    end

    if BR.FocusMode == "Potential Development" then
        return amount * (32 + weight * 170)
    elseif BR.FocusMode == "GOAT Career" then
        return amount * (20 + weight * 125)
    elseif BR.FocusMode == "Career Max" then
        return amount * (10 + weight * 90)
    end

    return amount * (3 + weight * 35)
end

function BR.effectScore(effects)
    if type(effects) ~= "table" then
        return 0
    end

    local score = 0
    local focus = BR.FocusMode

    local ratingWeight = 1000
    if focus == "GOAT Career" then
        ratingWeight = 520
    elseif focus == "Potential Development" then
        ratingWeight = 250
    elseif focus == "Career Max" then
        ratingWeight = 420
    end

    score = score + (tonumber(effects.ratingDelta) or 0) * ratingWeight

    if effects.goal == true then
        score = score + (focus == "Rating Focus" and 180 or 260)
    end
    if effects.assist == true then
        score = score + (focus == "Rating Focus" and 130 or 210)
    end
    if effects.save == true then
        score = score + (focus == "Rating Focus" and 150 or 230)
    end
    if effects.cleanSheet == true or effects.cs == true then
        score = score + (focus == "Rating Focus" and 120 or 190)
    end

    if effects.concede == true then score = score - 240 end
    if effects.red == true or effects.redCard == true then score = score - 420 end
    if effects.cardYellow == true then score = score - 45 end
    if effects.suspend then
        score = score - math.abs(tonumber(effects.suspend) or 1) * 120
    end

    -- Injury is especially bad for developing a high-potential career:
    -- missed weeks = fewer matches/training + possible early retirement.
    if effects.injury then
        local injury = tonumber(effects.injury) or 1

        if injury > 0 then
            local injuryWeight =
                focus == "Potential Development" and 180
                or focus == "GOAT Career" and 140
                or 70

            score = score - injury * injuryWeight
        elseif injury < 0 then
            score = score + math.abs(injury) * 110
        end
    end

    if effects.heal == true then score = score + 500 end
    if effects.healHalf == true then score = score + 240 end

    for _, stat in ipairs(BR.StatKeys) do
        if effects[stat] ~= nil then
            score = score + BR.statImpact(stat, effects[stat])
        end
    end

    if effects.technique ~= nil then
        score = score + BR.statImpact("technique", effects.technique)
    end

    if effects.physique ~= nil then
        score = score + BR.statImpact("physique", effects.physique)
    end

    local xpWeight = 1.4
    local formeWeight = 8
    local moralWeight = 4
    local disciplineWeight = 7
    local coachWeight = 5
    local dressingWeight = 3
    local repWeight = 3

    if focus == "GOAT Career" then
        xpWeight = 3.0
        formeWeight = 18
        moralWeight = 7
        disciplineWeight = 12
        coachWeight = 10
        dressingWeight = 6
        repWeight = 18
    elseif focus == "Potential Development" then
        xpWeight = 4.2
        formeWeight = 24
        moralWeight = 7
        disciplineWeight = 14
        coachWeight = 13
        dressingWeight = 4
        repWeight = 12
    elseif focus == "Career Max" then
        xpWeight = 2.5
        formeWeight = 14
        moralWeight = 7
        disciplineWeight = 12
        coachWeight = 9
        dressingWeight = 5
        repWeight = 10
    end

    score = score + (tonumber(effects.xp) or 0) * xpWeight
    score = score + (tonumber(effects.forme) or 0) * formeWeight
    score = score + (tonumber(effects.moral) or 0) * moralWeight
    score = score + (tonumber(effects.discipline) or 0) * disciplineWeight
    score = score + (tonumber(effects.relCoach) or 0) * coachWeight
    score = score + (tonumber(effects.vestiaire) or 0) * dressingWeight
    score = score + (tonumber(effects.rep) or 0) * repWeight

    -- Reputation is especially useful while scouts are uncertain because the
    -- displayed estimate becomes more accurate as reputation rises.
    if BR.CurrentReputation ~= nil and BR.CurrentReputation < 50 then
        score = score + (tonumber(effects.rep) or 0) * (
            focus == "GOAT Career" and 8
            or focus == "Potential Development" and 6
            or 2
        )
    end

    local money = tonumber(effects.money) or 0
    if money ~= 0 then
        local moneyDivisor =
            focus == "GOAT Career" and 3000
            or focus == "Potential Development" and 5000
            or 5000

        score = score + math.clamp(money / moneyDivisor, -80, 80)
    end

    return score
end

