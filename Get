stage("4/5 Controller environments/closures")

section(M.Files.Connections, "RELEVANT CONTROLLER ENVIRONMENTS")

local controllerCount = 0

for _, object in ipairs(player:FindFirstChild("PlayerScripts")
        and player.PlayerScripts:GetDescendants()
        or {}) do

    if object:IsA("LocalScript")
        and relevant(fullName(object)) then

        controllerCount += 1

        append(M.Files.Connections, "")
        append(
            M.Files.Connections,
            "CONTROLLER",
            controllerCount,
            fullName(object)
        )

        if type(getsenv) == "function" then
            local ok, env = pcall(getsenv, object)
            if ok then
                append(
                    M.Files.Connections,
                    "ENV=",
                    clip(serialize(env), 60000)
                )
                walkFunctions(
                    M.Files.Connections,
                    fullName(object) .. ".ENV",
                    env,
                    0,
                    {}
                )
            else
                append(
                    M.Files.Connections,
                    "getsenv error=",
                    tostring(env)
                )
            end
        end

        for _, getterName in ipairs({
            "getscriptclosure",
            "getscriptfunction",
        }) do
            local getter = getgenv()[getterName]

            if type(getter) == "function" then
                local ok, fn = pcall(getter, object)

                if ok and type(fn) == "function" then
                    dumpFunction(
                        M.Files.Connections,
                        fullName(object) .. "." .. getterName,
                        fn
                    )
                end
            end
        end
    end
end

append(M.Files.Summary, "Relevant controllers:", controllerCount)

