stage("3/5 Relevant GUI callbacks")

section(M.Files.Connections, "RELEVANT GUI BUTTON CALLBACKS")

local buttonCount = 0
local connectionCount = 0

if type(getconnections) == "function" then
    for index, object in ipairs(playerGui:GetDescendants()) do
        if object:IsA("GuiButton") then
            local textBlob = fullName(object) .. " " .. object.Name

            for _, child in ipairs(object:GetDescendants()) do
                if child:IsA("TextLabel")
                    or child:IsA("TextButton")
                    or child:IsA("TextBox") then
                    textBlob = textBlob .. " " .. tostring(child.Text)
                end
            end

            if object:IsA("TextButton") then
                textBlob = textBlob .. " " .. tostring(object.Text)
            end

            if relevant(textBlob) then
                buttonCount += 1

                append(M.Files.Connections, "")
                append(
                    M.Files.Connections,
                    "BUTTON",
                    buttonCount,
                    fullName(object),
                    "TEXTBLOB=" .. string.format("%q", clip(textBlob, 3000))
                )

                local signals = {
                    {"Activated", object.Activated},
                }

                pcall(function()
                    table.insert(
                        signals,
                        {"MouseButton1Click", object.MouseButton1Click}
                    )
                    table.insert(
                        signals,
                        {"MouseButton1Down", object.MouseButton1Down}
                    )
                end)

                for _, signalInfo in ipairs(signals) do
                    local ok, connections = pcall(
                        getconnections,
                        signalInfo[2]
                    )

                    if ok and type(connections) == "table" then
                        append(
                            M.Files.Connections,
                            "SIGNAL",
                            signalInfo[1],
                            "count=" .. tostring(#connections)
                        )

                        for i, connection in ipairs(connections) do
                            if i > 30 then break end

                            local fn = nil
                            pcall(function()
                                fn = connection.Function
                            end)

                            connectionCount += 1

                            if type(fn) == "function" then
                                dumpFunction(
                                    M.Files.Connections,
                                    fullName(object)
                                        .. "."
                                        .. signalInfo[1]
                                        .. "#"
                                        .. tostring(i),
                                    fn
                                )
                            else
                                append(
                                    M.Files.Connections,
                                    "CONNECTION",
                                    i,
                                    "no exposed Function"
                                )
                            end
                        end
                    end
                end
            end
        end

        if index % 300 == 0 then
            task.wait()
        end
    end
end

append(M.Files.Summary, "Relevant buttons:", buttonCount)
append(M.Files.Summary, "Connection functions inspected:", connectionCount)

