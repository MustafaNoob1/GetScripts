function BR.moneyFromTables(tbl, owner)
    local candidates = {
        tbl,
        owner
    }

    if type(owner) == "table" then
        for _, key in ipairs({
            "player",
            "career",
            "profile",
            "data",
            "state",
            "current"
        }) do
            if type(owner[key]) == "table" then
                table.insert(candidates, owner[key])
            end
        end
    end

    for _, candidate in ipairs(candidates) do
        if type(candidate) == "table" then
            for _, key in ipairs({
                "money",
                "Money",
                "cash",
                "Cash",
                "bank",
                "Bank"
            }) do
                local value = tonumber(candidate[key])

                if value ~= nil and value >= 0 then
                    return value, tostring(key)
                end
            end
        end
    end

    return nil, nil
end

function BR.currentMoney()
    local money, source = BR.moneyFromTables(BR.Stats, BR.StatsOwner)

    if money ~= nil then
        BR.CurrentMoney = money
        BR.MoneySource = "career." .. tostring(source or "money")
        return money
    end

    return BR.CurrentMoney
end

function BR.stateCandidates()
    local result = {}
    local seen = {}

    local function add(tbl)
        if type(tbl) == "table" and not seen[tbl] then
            seen[tbl] = true
            table.insert(result, tbl)
        end
    end

    add(BR.Stats)
    add(BR.StatsOwner)

    if type(BR.StatsOwner) == "table" then
        for _, key in ipairs({
            "stats", "player", "career", "profile",
            "data", "state", "current", "save"
        }) do
            add(BR.StatsOwner[key])
        end
    end

    return result
end

function BR.readCareerNumber(keys, minValue, maxValue)
    for _, tbl in ipairs(BR.stateCandidates()) do
        for _, key in ipairs(keys) do
            local value = tonumber(tbl[key])

            if value ~= nil
                and (minValue == nil or value >= minValue)
                and (maxValue == nil or value <= maxValue) then
                return value, tostring(key)
            end
        end
    end

    return nil, nil
end

