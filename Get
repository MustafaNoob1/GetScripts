function BR.registerChoice(choice, eventInfo)
    if type(choice) ~= "table" or type(choice.text) ~= "string" then
        return
    end

    local key = BR.norm(choice.text)
    if key == "" then
        return
    end

    BR.ChoiceIndex[key] = BR.ChoiceIndex[key] or {}

    table.insert(BR.ChoiceIndex[key], {
        Choice = choice,
        Event = eventInfo
    })
end

function BR.walkEvents(node, parentEvent, seen)
    if type(node) ~= "table" then
        return
    end

    seen = seen or {}
    if seen[node] then
        return
    end
    seen[node] = true

    local nextEvent = parentEvent

    if type(node.id) == "string"
        and type(node.title) == "string"
        and type(node.choices) == "table" then
        nextEvent = node

        for _, choice in ipairs(node.choices) do
            BR.registerChoice(choice, node)
        end
    end

    for key, value in pairs(node) do
        if type(value) == "table" and key ~= "choices" then
            BR.walkEvents(value, nextEvent, seen)
        end
    end
end

BR.walkEvents(BR.Events, nil, {})

