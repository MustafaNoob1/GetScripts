-- UI/event helpers.
function S.visible(o)
    if not o or not o.Parent then return false end
    local c = o
    while c and c ~= game do
        if c:IsA("GuiObject") and not c.Visible then return false end
        if c:IsA("ScreenGui") and not c.Enabled then return false end
        c = c.Parent
    end
    return true
end
function S.currentEvent()
    for _, o in ipairs(S.Gui:GetDescendants()) do
        if (o:IsA("TextLabel") or o:IsA("TextButton")) and S.visible(o) and type(o.Text)=="string" then
            local ev = S.EventTitles[S.norm(o.Text)]
            if ev then return ev end
        end
    end
end
function S.visibleChoices()
    local out = {}
    for _, o in ipairs(S.Gui:GetDescendants()) do
        if o:IsA("GuiButton") and S.visible(o) then
            local texts = {}
            if o:IsA("TextButton") and S.norm(o.Text)~="" then table.insert(texts,o.Text) end
            for _, c in ipairs(o:GetDescendants()) do
                if (c:IsA("TextLabel") or c:IsA("TextButton")) and c.Visible and type(c.Text)=="string" and S.norm(c.Text)~="" then table.insert(texts,c.Text) end
            end
            local hit = false
            for _, t in ipairs(texts) do if S.ChoiceTexts[S.norm(t)] then hit=true break end end
            if hit then table.insert(out,{Path=S.path(o),Active=o.Active,Texts=texts}) end
        end
    end
    return out
end
function S.uiSnapshot()
    local out = {}
    for _, o in ipairs(S.Gui:GetDescendants()) do
        if (o:IsA("TextLabel") or o:IsA("TextButton")) and S.visible(o) and type(o.Text)=="string" and S.norm(o.Text)~="" then
            table.insert(out,o.ClassName.."|"..S.path(o).."|"..S.clip(o.Text,600))
        end
    end
    table.sort(out)
    return out
end

-- Passive incoming RemoteEvent logging only.
function S.args(...)
    local out = {}
    for i=1,math.min(select("#",...),20) do out[i]=S.serialize(select(i,...)) end
    return table.concat(out," | ")
end
for _, o in ipairs(S.RS:GetDescendants()) do
    if o:IsA("RemoteEvent") then
        local ok, con = pcall(function()
            return o.OnClientEvent:Connect(function(...)
                if S.Alive then S.log("REMOTE_IN", S.path(o).." :: "..S.args(...)) end
            end)
        end)
        if ok and con then table.insert(S.RemoteConnections,con) end
    end
end

function S.stateFP(t)
    if type(t)~="table" then return "none" end
    local out = {}
    for _, k in ipairs({"age","season","seasons","position","ovr","overall","peak","pot","potential","potMin","potMax","money","rep","reputation","forme","moral","discipline","tir","passe","dribble","vitesse","puissance","defense","mental","injury","injured","suspend","playstyle"}) do
        table.insert(out,k.."="..tostring(rawget(t,k)))
    end
    return table.concat(out,";")
end
function S.logState(reason)
    local t, score, all = S.bestState()
    if t then S.log("STATE_"..tostring(reason),"score="..score.." :: "..S.serialize(S.shallowState(t))) else S.log("STATE_"..tostring(reason),"none") end
    if all and #all>1 then
        local alt = {}
        for i=2,math.min(#all,5) do table.insert(alt,"score="..all[i].Score..":"..S.serialize(S.shallowState(all[i].Table))) end
        if #alt>0 then S.log("STATE_ALTS",table.concat(alt," || ")) end
    end
end

S.logState("INITIAL")

task.spawn(function()
    while S.Alive do
        task.wait(0.45)
        local state = S.bestState()
        local fp = S.stateFP(state)
        if fp ~= S.LastStateFP then S.LastStateFP=fp; S.logState("CHANGE") end

        local ev = S.currentEvent()
        local choices = S.visibleChoices()
        local cp = {}
        for _, c in ipairs(choices) do table.insert(cp,c.Path.."{"..table.concat(c.Texts," / ").."}") end
        table.sort(cp)
        local efp = (ev and tostring(ev.id) or "none") .. "::" .. table.concat(cp,"||")
        if efp ~= S.LastEventFP then
            S.LastEventFP = efp
            if ev then
                S.log("EVENT","id="..tostring(ev.id).." title="..tostring(ev.title).." choices="..S.serialize(choices).." data="..S.serialize(ev))
            elseif #choices>0 then
                S.log("CHOICES_NO_TITLE",S.serialize(choices))
            end
        end

        local rows = S.uiSnapshot()
        local ufp = table.concat(rows,"\n")
        if ufp ~= S.LastUiFP then
            S.LastUiFP = ufp
            local preview = #ufp>30000 and (ufp:sub(1,30000).."\n<UI truncated>") or ufp
            S.log("UI_CHANGE",preview)
        end

        if os.clock()-S.LastFlush>4 then S.flush() end
    end
end)

function S:Snapshot(label)
    self.log("MANUAL",label or "snapshot")
    self.logState("MANUAL")
    local ev = self.currentEvent()
    if ev then self.log("MANUAL_EVENT",self.serialize(ev)) end
    self.flush()
end

function S:Stop()
    self.Alive=false
    for _, c in ipairs(self.RemoteConnections) do pcall(function() c:Disconnect() end) end
    self.flush()
    warn("[GOATScanner] STOPPED - upload GOATScan_FullDump.txt + GOATScan_LiveTelemetry.txt")
end

task.delay(90*60,function() if S.Alive then S:Stop() end end)

