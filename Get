------------------------------------------------------------
-- DRAW SEGMENT
------------------------------------------------------------

local function drawSegment(
    pointA,
    pointB,
    appearance,
    run
)

    local worldA =
        toWorld(
            pointA[1],
            pointA[2],
            0
        )

    local worldB =
        toWorld(
            pointB[1],
            pointB[2],
            0
        )

    local delta =
        worldB
        - worldA

    local length =
        delta.Magnitude

    if length
        < 0.001 then

        return true

    end

    local spacing =
        math.max(

            appearance.BrushSize
            * 0.25,

            0.1

        )

    local steps =
        math.max(
            1,
            math.ceil(
                length
                / spacing
            )
        )

    if not hasSurface(
        worldA
    ) then

        Status.Text =
            "STOP: Design verlässt die Wand."

        return false

    end

    local previous =
        worldA

    DrawHandler:AddSprayToBatch(

        sprayData(
            worldA,
            worldA,
            appearance
        )

    )

    for i = 1,
        steps do

        if not Painting
            or run ~= PaintRun then

            return false

        end

        local alpha =
            i / steps

        local current =
            worldA
            + delta
            * alpha

        local root =
            getRoot()

        if not root then
            return false
        end

        if (
            root.Position
            - current
        ).Magnitude
            >= MAX_RANGE then

            Status.Text =
                "STOP: Außerhalb der Paint Range."

            return false

        end

        if not hasSurface(
            current
        ) then

            Status.Text =
                "STOP: Design geht über die Wandkante."

            return false

        end

        DrawHandler:AddSprayToBatch(

            sprayData(
                previous,
                current,
                appearance
            )

        )

        previous =
            current

        if i
            % POINT_CHUNK
            == 0 then

            task.wait(
                POINT_DELAY
            )

        end

    end

    return true

end


------------------------------------------------------------
-- DRAW STROKE
------------------------------------------------------------

local function drawStroke(
    strokeData,
    run
)

    local points =
        strokeData.Points

    if #points < 2 then
        return true
    end

    local appearance =
        makeAppearance(
            strokeData
        )

    for i = 1,
        #points - 1 do

        local result =
            drawSegment(

                points[i],

                points[
                    i + 1
                ],

                appearance,

                run

            )

        if not result then
            return false
        end

    end

    DrawHandler
        :RenderBatch()

    task.wait(
        STROKE_DELAY
    )

    return true

end


------------------------------------------------------------
-- PAINT COMPLETE DESIGN
------------------------------------------------------------

local function paintMSTI(
    run
)

    PreviewFolder.Parent =
        nil

    for index,
        strokeData in ipairs(
            DESIGN
        ) do

        if not Painting
            or PaintRun ~= run then

            break

        end

        Status.Text =
            string.format(
                "MSTI wird gemalt... %d/%d",
                index,
                #DESIGN
            )

        Status.TextColor3 =
            COLOR.LightPurple

        local success =
            drawStroke(
                strokeData,
                run
            )

        if not success then
            break
        end

    end

    pcall(
        function()

            DrawHandler
                :RenderBatch()

        end
    )

    PreviewFolder.Parent =
        Workspace

    Painting =
        false

    if run
        == PaintRun then

        Status.Text =
            "✓ MSTI fertig"

        Status.TextColor3 =
            Color3.fromRGB(
                100,
                255,
                140
            )

    end

end


