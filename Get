--------------------------------------------------
-- OUTPUT
--------------------------------------------------

local manifest = {}

local function log(...)
    local args = {...}
    local result = {}

    for i, value in ipairs(args) do
        result[i] = tostring(value)
    end

    local text = table.concat(result, " ")

    table.insert(manifest, text)
    print(text)
end

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function sanitize(text)

    text = tostring(text)

    text = text:gsub("[^%w%._%-]", "_")

    if #text > 150 then
        text = text:sub(1, 150)
    end

    return text
end

local function nameInteresting(name)

    local lower = string.lower(name)

    for _, keyword in ipairs(NAME_KEYWORDS) do

        if string.find(
            lower,
            string.lower(keyword),
            1,
            true
        ) then

            return true
        end
    end

    return false
end

local function sourceInteresting(source)

    local matches = {}

    for _, keyword in ipairs(SOURCE_KEYWORDS) do

        if string.find(
            source,
            keyword,
            1,
            true
        ) then

            table.insert(matches, keyword)
        end
    end

    return #matches > 0, matches
end

--------------------------------------------------
-- STORAGE
--------------------------------------------------

local seen = {}

local dumped = 0
local checked = 0

--------------------------------------------------
-- DUMP FUNCTION
--------------------------------------------------

local function checkScript(obj, reason)

    if not obj then
        return
    end

    if seen[obj] then
        return
    end

    seen[obj] = true

    if not (
        obj:IsA("ModuleScript")
        or obj:IsA("LocalScript")
        or obj:IsA("Script")
    ) then
        return
    end

    checked += 1

    local nameHit =
        nameInteresting(obj.Name)

    local ok, source =
        pcall(function()

            return decompile(obj)

        end)

    if not ok or type(source) ~= "string" then

        if nameHit then

            log(
                "[DECOMPILE FAILED]",
                obj.ClassName,
                obj:GetFullName()
            )

        end

        return
    end

    local sourceHit, matches =
        sourceInteresting(source)

    if not nameHit and not sourceHit then
        return
    end

    dumped += 1

    local filename =
        string.format(
            "%03d_%s.lua",
            dumped,
            sanitize(obj:GetFullName())
        )

    local path =
        FOLDER .. "/" .. filename

    local header =
        "-- ORIGINAL PATH:\n"
        .. "-- "
        .. obj:GetFullName()
        .. "\n\n"
        .. "-- CLASS:\n"
        .. "-- "
        .. obj.ClassName
        .. "\n\n"
        .. "-- FOUND BECAUSE:\n"
        .. "-- "
        .. tostring(reason)
        .. "\n\n"
        .. "-- SOURCE KEYWORDS:\n"
        .. "-- "
        .. table.concat(matches, ", ")
        .. "\n\n"

    local success, err =
        pcall(function()

            writefile(
                path,
                header .. source
            )

        end)

    if success then

        log("")
        log("[SCRIPT]", obj:GetFullName())
        log(" File:", filename)
        log(" Class:", obj.ClassName)
        log(" NameMatch:", nameHit)
        log(" Keywords:", table.concat(matches, ", "))
        log(" Length:", #source)

    else

        log(
            "[WRITE FAILED]",
            filename,
            err
        )

    end
end

--------------------------------------------------
-- SCAN ROOT
--------------------------------------------------

local function scanRoot(root, description)

    if not root then
        return
    end

    log("")
    log("====================================")
    log("SCANNING:", description)
    log("PATH:", root:GetFullName())
    log("====================================")

    checkScript(root, description)

    for _, obj in ipairs(root:GetDescendants()) do

        checkScript(
            obj,
            description
        )

    end
end

