-- Script source dump.
F("================ CLIENT SOURCES ================")
local scripts, seenScripts = {}, {}
local function addScript(inst, reason)
    if typeof(inst) ~= "Instance" or not inst:IsA("LuaSourceContainer") then return end
    local p = S.path(inst)
    if seenScripts[p] then return end
    seenScripts[p] = true
    table.insert(scripts, {Inst=inst, Reason=reason})
end
if S.DayFoot then for _, o in ipairs(S.DayFoot:GetDescendants()) do addScript(o, "DayFoot") end end
local ps = S.Player:FindFirstChild("PlayerScripts")
if ps then for _, o in ipairs(ps:GetDescendants()) do addScript(o, "PlayerScripts") end end
