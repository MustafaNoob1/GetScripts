--------------------------------------------------
-- VALIDATE DRAW POSITION
--------------------------------------------------

local function validateSelectedPosition()

    if not Selected then

        return false,
            "Erst eine Wand auswählen."

    end

    if not Selected.Part
        or not Selected.Part.Parent then

        return false,
            "Die ausgewählte Wand existiert nicht mehr."

    end

    local root =
        getRoot()

    if not root then

        return false,
            "HumanoidRootPart nicht gefunden."

    end

    local distance =
        (
            Selected.Position
            - root.Position
        ).Magnitude

    if distance
        >= MAX_DRAW_RANGE then

        return false,
            string.format(
                "Zu weit von der Wand entfernt: %.1f Studs",
                distance
            )

    end

    return true

end

--------------------------------------------------
