function BR.parseChanceFromButton(button)
    if not button then
        return nil
    end

    local texts = {}

    if button:IsA("TextButton") then
        table.insert(texts, button.Text)
    end

    for _, object in ipairs(button:GetDescendants()) do
        if (object:IsA("TextLabel") or object:IsA("TextButton"))
            and object.Visible
            and type(object.Text) == "string" then
            table.insert(texts, object.Text)
        end
    end

    for _, text in ipairs(texts) do
        local value = string.match(text, "(%d+)%s*%%")
        if value then
            local n = tonumber(value)
            if n and n >= 0 and n <= 100 then
                return n
            end
        end
    end

    return nil
end

function BR.rollChance(choice, button)
    if type(choice) ~= "table" or type(choice.roll) ~= "table" then
        return nil
    end

    local displayed = BR.parseChanceFromButton(button)
    if displayed then
        return displayed
    end

    local stats = BR.Stats or BR.findStats()

    if stats and type(BR.Config.rollChance) == "function" then
        local ok, chance = pcall(
            BR.Config.rollChance,
            stats,
            choice.roll.stat,
            choice.roll.dc
        )

        if ok and tonumber(chance) then
            return math.clamp(tonumber(chance), 0, 100)
        end
    end

    return 50
end

function BR.ratingProfile(choice, button)
    local base = 0

    if type(choice.effects) == "table" then
        base = tonumber(choice.effects.ratingDelta) or 0
    end

    if type(choice.roll) ~= "table" then
        return {
            Worst = base,
            Best = base,
            Expected = base,
            SafeProbability = base >= 0 and 1 or 0
        }
    end

    local chance = BR.rollChance(choice, button) or 50
    local p = math.clamp(chance / 100, 0, 1)

    local successDelta =
        base
        + (type(choice.success) == "table"
            and (tonumber(choice.success.ratingDelta) or 0)
            or 0)

    local failDelta =
        base
        + (type(choice.fail) == "table"
            and (tonumber(choice.fail.ratingDelta) or 0)
            or 0)

    local safeProbability = 0

    if successDelta >= 0 and failDelta >= 0 then
        safeProbability = 1
    elseif successDelta >= 0 and failDelta < 0 then
        safeProbability = p
    elseif successDelta < 0 and failDelta >= 0 then
        safeProbability = 1 - p
    end

    return {
        Worst = math.min(successDelta, failDelta),
        Best = math.max(successDelta, failDelta),
        Expected = successDelta * p + failDelta * (1 - p),
        SafeProbability = safeProbability
    }
end

function BR.buttonInteractable(button)
    if not button or not BR.isActuallyVisible(button) then
        return false, "not visible"
    end

    if button:IsA("GuiButton") then
        if button.Active == false then
            return false, "button inactive"
        end

        local okInteractable, interactable = pcall(function()
            return button.Interactable
        end)

        if okInteractable and interactable == false then
            return false, "button not interactable"
        end
    end

    if button:GetAttribute("Disabled") == true
        or button:GetAttribute("Locked") == true
        or button:GetAttribute("Busy") == true then
        return false, "button disabled"
    end

    return true, nil
end

function BR.choiceKey(choice, eventInfo)
    return tostring(eventInfo and eventInfo.id or "?")
        .. "::"
        .. BR.norm(choice and choice.text or "?")
end

function BR.choiceAffordable(choice)
    local cost = tonumber(choice and choice.cost) or 0

    if cost <= 0 then
        return true, cost, nil
    end

    local money = BR.currentMoney()

    if money ~= nil then
        if money >= cost then
            return true, cost, nil
        end

        return false, cost,
            "need " .. BR.short(cost)
            .. " | have " .. BR.short(money)
    end

    if BR.SkipPaidWhenMoneyUnknown then
        return false, cost, "money unknown"
    end

    return true, cost, "money unknown"
end

function BR.choiceScore(choice, button)
    local base = BR.effectScore(choice.effects)
    local chance = nil
    local success = nil
    local fail = nil

    if type(choice.roll) == "table" then
        chance = BR.rollChance(choice, button) or 50
        local p = chance / 100

        success = BR.effectScore(choice.success)
        fail = BR.effectScore(choice.fail)

        local rollScore = 0

        if BR.RiskMode == "Max Upside" then
            rollScore = success
        elseif BR.RiskMode == "Safe" or BR.RiskMode == "Never Minus" then
            rollScore = math.min(success, fail) * 0.70
                + (success * p + fail * (1 - p)) * 0.30
        else
            rollScore = success * p + fail * (1 - p)
        end

        base = base + rollScore
    end

    local cost = tonumber(choice.cost) or 0
    if cost > 0 then
        local money = BR.currentMoney()
        local ratio = 1

        if money ~= nil and money > 0 then
            ratio = math.clamp(cost / money, 0, 2)
        end

        -- Paid options are not free value. A direct rating gain can still
        -- outweigh this, but the optimizer will not waste all cash for a
        -- tiny secondary-stat improvement.
        local penalty = BR.FocusMode == "Rating Focus"
            and (25 + ratio * 60)
            or (40 + ratio * 110)

        base = base - penalty
    end

    return base, chance, success, fail
end

function BR.evaluateChoice(choice, button, eventInfo)
    local interactable, disabledReason = BR.buttonInteractable(button)

    if not interactable then
        return nil, "disabled", disabledReason
    end

    local key = BR.choiceKey(choice, eventInfo)
    local blockedUntil = tonumber(BR.BlockedChoiceUntil[key]) or 0

    if blockedUntil > os.clock() then
        return nil, "blocked", "recent click was rejected"
    end

    local affordable, cost, affordabilityReason = BR.choiceAffordable(choice)

    if not affordable then
        return nil, "unaffordable", affordabilityReason
    end

    local score, chance, success, fail = BR.choiceScore(choice, button)
    local profile = BR.ratingProfile(choice, button)

    return {
        Button = button,
        Choice = choice,
        Event = eventInfo,
        Text = choice.text,
        Score = score,
        Chance = chance,
        SuccessScore = success,
        FailScore = fail,
        Cost = cost,
        Money = BR.currentMoney(),
        WorstRating = profile.Worst,
        BestRating = profile.Best,
        ExpectedRating = profile.Expected,
        SafeProbability = profile.SafeProbability,
        AffordabilityReason = affordabilityReason,
        Key = key
    }, nil, nil
end

function BR.betterCandidate(a, b)
    if not b then
        return true
    end

    if BR.RiskMode == "Never Minus" then
        local aSafe = (a.WorstRating or 0) >= 0
        local bSafe = (b.WorstRating or 0) >= 0

        if aSafe ~= bSafe then
            return aSafe
        end

        if aSafe then
            if (a.WorstRating or 0) ~= (b.WorstRating or 0) then
                return (a.WorstRating or 0) > (b.WorstRating or 0)
            end

            if (a.ExpectedRating or 0) ~= (b.ExpectedRating or 0) then
                return (a.ExpectedRating or 0) > (b.ExpectedRating or 0)
            end
        else
            if (a.SafeProbability or 0) ~= (b.SafeProbability or 0) then
                return (a.SafeProbability or 0) > (b.SafeProbability or 0)
            end

            if (a.WorstRating or 0) ~= (b.WorstRating or 0) then
                return (a.WorstRating or 0) > (b.WorstRating or 0)
            end

            if (a.ExpectedRating or 0) ~= (b.ExpectedRating or 0) then
                return (a.ExpectedRating or 0) > (b.ExpectedRating or 0)
            end
        end
    elseif BR.RiskMode == "Safe" then
        if (a.WorstRating or 0) ~= (b.WorstRating or 0) then
            return (a.WorstRating or 0) > (b.WorstRating or 0)
        end

        if (a.SafeProbability or 0) ~= (b.SafeProbability or 0) then
            return (a.SafeProbability or 0) > (b.SafeProbability or 0)
        end
    end

    return (a.Score or -math.huge) > (b.Score or -math.huge)
end

