------------------------------------------------------------
-- RAYCAST
------------------------------------------------------------

local function raycastMouse()

    local pos =
        UserInputService
            :GetMouseLocation()

    local inset =
        GuiService:GetGuiInset()

    pos -= inset

    local ray =
        Camera:ViewportPointToRay(
            pos.X,
            pos.Y
        )

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.RespectCanCollide =
        false

    local ignore = {
        PreviewFolder
    }

    if Player.Character then

        table.insert(
            ignore,
            Player.Character
        )

    end

    local sprays =
        Workspace
            :FindFirstChild(
                "SprayPaint"
            )

    if sprays then

        table.insert(
            ignore,
            sprays
        )

    end

    params.FilterDescendantsInstances =
        ignore

    return Workspace:Raycast(
        ray.Origin,
        ray.Direction * 500,
        params
    )

end


------------------------------------------------------------
-- WALL AXES
------------------------------------------------------------

local function makeBasis(
    normal
)

    normal =
        normal.Unit

    local right =
        Vector3.new(
            0,
            1,
            0
        )
        :Cross(
            normal
        )

    if right.Magnitude
        < 0.01 then

        right =
            Camera.CFrame.RightVector

        right =
            right
            - normal
            * right:Dot(
                normal
            )

    end

    right =
        right.Unit

    local up =
        normal
            :Cross(
                right
            )
            .Unit

    return right,
        up

end


------------------------------------------------------------
-- ROTATION
------------------------------------------------------------

local function getBasis()

    local rad =
        math.rad(
            Rotation
        )

    local cos =
        math.cos(rad)

    local sin =
        math.sin(rad)

    local right =
        Selected.Right * cos
        + Selected.Up * sin

    local up =
        Selected.Up * cos
        - Selected.Right * sin

    return right,
        up

end


------------------------------------------------------------
-- 2D -> WORLD
------------------------------------------------------------

local function toWorld(
    x,
    y,
    offset
)

    if not Selected then
        return nil
    end

    offset =
        offset or 0

    local right,
        up =
        getBasis()

    return
        Selected.Position

        + right
        * (
            x
            * BASE_WIDTH
            * Scale
        )

        + up
        * (
            y
            * BASE_HEIGHT
            * Scale
        )

        + Selected.Normal
        * offset

end


------------------------------------------------------------
-- SURFACE TEST
------------------------------------------------------------

local function hasSurface(
    point
)

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.RespectCanCollide =
        false

    local ignore = {
        PreviewFolder
    }

    if Player.Character then

        table.insert(
            ignore,
            Player.Character
        )

    end

    local sprays =
        Workspace
            :FindFirstChild(
                "SprayPaint"
            )

    if sprays then

        table.insert(
            ignore,
            sprays
        )

    end

    params.FilterDescendantsInstances =
        ignore

    local hit =
        Workspace:Raycast(

            point
            + Selected.Normal * 0.75,

            -Selected.Normal * 2.25,

            params

        )

    if not hit then
        return false
    end

    if hit.Normal
        :Dot(
            Selected.Normal
        ) < 0.85 then

        return false
    end

    local distance =
        math.abs(

            (
                hit.Position
                - point
            )
            :Dot(
                Selected.Normal
            )

        )

    return distance
        <= 0.45

end


------------------------------------------------------------
-- LAYER SYSTEM
--
-- Game SetPaintLayer:
-- requested layer + 10 = internal PaintLayer
------------------------------------------------------------

local STYLE_LAYER_COUNT =
    7


local function getLayerPlan()

    local currentInternal =
        tonumber(
            DrawHandler
                .DynamicConfig
                .CurrentPaintLayer
        )
        or 10

    --------------------------------------------------------
    -- Convert game internal value back to selected layer
    --------------------------------------------------------

    local selectedLayer =
        math.max(
            0,
            currentInternal - 10
        )

    --------------------------------------------------------
    -- Without pass the game accepts user layers 0..9.
    --
    -- With PaintLayers we allow a larger range, but keep
    -- internal PaintLayer <= 100 because receiving clients
    -- clamp it there.
    --------------------------------------------------------

    local maxLayer

    if Capability.PaintLayers then

        maxLayer =
            90

    else

        maxLayer =
            9

    end

    selectedLayer =
        math.clamp(
            selectedLayer,
            0,
            maxLayer
        )

    local maximumStart =
        math.max(
            0,
            maxLayer
            - (
                STYLE_LAYER_COUNT - 1
            )
        )

    local start =
        math.clamp(
            selectedLayer - 3,
            0,
            maximumStart
        )

    return {

        Start =
            start,

        Max =
            maxLayer

    }

end


local function internalLayer(
    order
)

    local plan =
        getLayerPlan()

    local visibleLayer =
        math.clamp(
            plan.Start + order,
            0,
            plan.Max
        )

    --------------------------------------------------------
    -- Same internal +10 used by SetPaintLayer
    --------------------------------------------------------

    return math.clamp(
        visibleLayer + 10,
        0,
        100
    )

end


