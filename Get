--------------------------------------------------
-- FUNCTION DUMP
--------------------------------------------------

local function dumpFunction(file, label, fn)
    if type(fn) ~= "function" then
        return
    end

    local name, source, line = "", "", ""

    if type(debug) == "table"
        and type(debug.info) == "function" then

        pcall(function()
            name = tostring(debug.info(fn, "n") or "")
            source = tostring(debug.info(fn, "s") or "")
            line = tostring(debug.info(fn, "l") or "")
        end)
    end

    append(
        file,
        "FUNCTION",
        label,
        "name=" .. name,
        "source=" .. source,
        "line=" .. line
    )

    if type(getconstants) == "function" then
        local ok, data = pcall(getconstants, fn)

        if ok then
            append(
                file,
                "CONSTANTS=",
                clip(serialize(data), 30000)
            )
        end
    end

    if type(getupvalues) == "function" then
        local ok, data = pcall(getupvalues, fn)

        if ok then
            append(
                file,
                "UPVALUES=",
                clip(serialize(data), 70000)
            )
        end
    end

    if type(getprotos) == "function" then
        local ok, protos = pcall(getprotos, fn)

        if ok and type(protos) == "table" then
            local meta = {}

            for i, proto in ipairs(protos) do
                if i > 80 then
                    break
                end

                local pn, ps = "", ""

                if type(debug) == "table"
                    and type(debug.info) == "function" then
                    pcall(function()
                        pn = tostring(debug.info(proto, "n") or "")
                        ps = tostring(debug.info(proto, "s") or "")
                    end)
                end

                table.insert(meta, {
                    index = i,
                    name = pn,
                    source = ps,
                })
            end

            append(file, "PROTOS=", serialize(meta))
        end
    end
end

local function walkFunctions(file, label, value, depth, seen)
    depth = depth or 0
    seen = seen or {}

    if depth > 8 then
        return
    end

    if type(value) == "function" then
        dumpFunction(file, label, value)
        return
    end

    if type(value) ~= "table" or seen[value] then
        return
    end

    seen[value] = true

    for k, v in pairs(value) do
        local childLabel = label .. "." .. tostring(k)

        if type(v) == "function" then
            dumpFunction(file, childLabel, v)
        elseif type(v) == "table" then
            walkFunctions(
                file,
                childLabel,
                v,
                depth + 1,
                seen
            )
        end
    end
end

--------------------------------------------------
-- CONTROLLER MODULES
--------------------------------------------------

section(T.Files.Controllers, "TARGET CONTROLLER MODULES")

local controllersFolder = playerScripts:FindFirstChild("Controllers")
local controllerCount = 0

if controllersFolder then
    for _, module in ipairs(controllersFolder:GetChildren()) do
        if module:IsA("ModuleScript")
            and T.ControllerNames[module.Name] then

            controllerCount += 1

            append(T.Files.Controllers, "")
            append(
                T.Files.Controllers,
                "------------------------------------------------------------"
            )
            append(
                T.Files.Controllers,
                "CONTROLLER",
                controllerCount,
                fullName(module)
            )
            append(
                T.Files.Controllers,
                "------------------------------------------------------------"
            )

            local ok, returned = pcall(require, module)

            if ok then
                append(
                    T.Files.Controllers,
                    "RETURN=",
                    clip(serialize(returned), 90000)
                )

                walkFunctions(
                    T.Files.Controllers,
                    fullName(module) .. ".RETURN",
                    returned,
                    0,
                    {}
                )
            else
                append(
                    T.Files.Controllers,
                    "REQUIRE_ERROR=",
                    tostring(returned)
                )
            end

            for _, getterName in ipairs({
                "getscriptclosure",
                "getscriptfunction",
            }) do
                local getter = getgenv()[getterName]

                if type(getter) == "function" then
                    local okGetter, fn = pcall(getter, module)

                    if okGetter and type(fn) == "function" then
                        dumpFunction(
                            T.Files.Controllers,
                            fullName(module) .. "." .. getterName,
                            fn
                        )
                    end
                end
            end

            task.wait()
        end
    end
end

append(T.Files.Summary, "Controllers inspected:", controllerCount)

