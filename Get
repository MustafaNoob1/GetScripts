--------------------------------------------------
-- ADD ONE 2D VECTOR SEGMENT
--------------------------------------------------

local function paintVectorSegment(
    pointA,
    pointB,
    appearance,
    run
)

    --------------------------------------------------
    -- IMPORTANT:
    -- actual paint = exact surface plane
    -- preview has separate visual offset
    --------------------------------------------------

    local worldA =
        toWorld(
            pointA[1],
            pointA[2],
            0
        )

    local worldB =
        toWorld(
            pointB[1],
            pointB[2],
            0
        )

    if not worldA
        or not worldB then

        return false

    end

    local delta =
        worldB - worldA

    local length =
        delta.Magnitude

    if length
        < 0.001 then

        return true

    end

    --------------------------------------------------
    -- SAME GENERAL SPACING AS LINE TOOL
    --------------------------------------------------

    local spacing =
        math.max(
            appearance.BrushSize
                * 0.25,
            0.1
        )

    local steps =
        math.max(
            1,
            math.ceil(
                length
                / spacing
            )
        )

    local previous =
        worldA

    --------------------------------------------------
    -- SURFACE VALIDATION
    --------------------------------------------------

    if not pointHasSurface(
        worldA
    ) then

        Status.Text =
            "STOP: Art geht über die ausgewählte Wand hinaus."

        Status.TextColor3 =
            Color3.fromRGB(
                255,
                120,
                90
            )

        return false

    end

    --------------------------------------------------
    -- INITIAL POINT
    --------------------------------------------------

    DrawHandler:AddSprayToBatch(

        makeSprayData(
            worldA,
            worldA,
            appearance
        )

    )

    --------------------------------------------------
    -- INTERPOLATED POINTS
    --------------------------------------------------

    for index = 1,
        steps do

        --------------------------------------------------
        -- STOP SUPPORT
        --------------------------------------------------

        if not Painting
            or run ~= PaintRun then

            return false

        end

        local alpha =
            index / steps

        local current =
            worldA
            + delta
            * alpha

        --------------------------------------------------
        -- RANGE
        --------------------------------------------------

        local root =
            getRoot()

        if not root then

            Status.Text =
                "STOP: Character nicht gefunden."

            return false

        end

        local distance =
            (
                current
                - root.Position
            ).Magnitude

        if distance
            >= MAX_DRAW_RANGE then

            Status.Text =
                "STOP: Ein Teil des Tags liegt außerhalb der Paint-Range."

            Status.TextColor3 =
                Color3.fromRGB(
                    255,
                    120,
                    90
                )

            return false

        end

        --------------------------------------------------
        -- SURFACE
        --------------------------------------------------

        if not pointHasSurface(
            current
        ) then

            Status.Text =
                "STOP: Ein Teil des Tags liegt außerhalb der Wand."

            Status.TextColor3 =
                Color3.fromRGB(
                    255,
                    120,
                    90
                )

            return false

        end

        --------------------------------------------------
        -- SEND THROUGH GAME DRAW HANDLER
        --------------------------------------------------

        DrawHandler:AddSprayToBatch(

            makeSprayData(
                previous,
                current,
                appearance
            )

        )

        previous =
            current

        --------------------------------------------------
        -- SMALL RATE LIMIT
        --------------------------------------------------

        if index
            % POINT_CHUNK
            == 0 then

            task.wait(
                POINT_DELAY
            )

        end

    end

    return true

end

--------------------------------------------------
-- PAINT LOGICAL STROKE
--------------------------------------------------

local function paintStroke(
    stroke,
    appearance,
    run
)

    if #stroke
        < 2 then

        return true

    end

    for index = 1,
        #stroke - 1 do

        local success =
            paintVectorSegment(

                stroke[index],

                stroke[
                    index + 1
                ],

                appearance,

                run

            )

        if not success then
            return false
        end

    end

    --------------------------------------------------
    -- FINISH NORMAL GAME STROKE
    --------------------------------------------------

    DrawHandler:RenderBatch()

    task.wait(
        STROKE_DELAY
    )

    return true

end

--------------------------------------------------
-- WHOLE MSTJ
--------------------------------------------------

local function paintMSTJ(
    run
)

    local appearance =
        getAppearance()

    Status.Text =
        "MSTJ wird gemalt..."

    Status.TextColor3 =
        Color3.fromRGB(
            190,
            120,
            255
        )

    --------------------------------------------------
    -- HIDE PREVIEW
    --------------------------------------------------

    PreviewFolder.Parent =
        nil

    --------------------------------------------------
    -- DRAW EACH STROKE
    --------------------------------------------------

    for index,
        stroke
        in ipairs(ART) do

        if not Painting
            or run ~= PaintRun then

            break

        end

        Status.Text =
            string.format(
                "MSTJ wird gemalt... %d/%d",
                index,
                #ART
            )

        local success =
            paintStroke(
                stroke,
                appearance,
                run
            )

        if not success then
            break
        end

    end

    --------------------------------------------------
    -- FINAL FLUSH
    --------------------------------------------------

    pcall(
        function()

            DrawHandler
                :RenderBatch()

        end
    )

    --------------------------------------------------
    -- RESTORE PREVIEW
    --------------------------------------------------

    PreviewFolder.Parent =
        Workspace

    Painting =
        false

    if run
        == PaintRun then

        Status.Text =
            "Paint-Vorgang beendet."

        Status.TextColor3 =
            Color3.fromRGB(
                100,
                255,
                140
            )

    end

end

--------------------------------------------------
-- START
--------------------------------------------------

StartButton
    .MouseButton1Click
    :Connect(
        function()

            if Painting then

                Status.Text =
                    "Es wird bereits gemalt."

                return

            end

            local valid,
                reason =
                validateSelectedPosition()

            if not valid then

                Status.Text =
                    reason

                Status.TextColor3 =
                    Color3.fromRGB(
                        255,
                        100,
                        100
                    )

                return

            end

            --------------------------------------------------
            -- CHECK WHOLE DESIGN FITS ON SURFACE
            --------------------------------------------------

            for _,
                stroke
                in ipairs(ART) do

                for _,
                    point
                    in ipairs(stroke) do

                    local worldPoint =
                        toWorld(
                            point[1],
                            point[2],
                            0
                        )

                    if not pointHasSurface(
                        worldPoint
                    ) then

                        Status.Text =
                            "Das MSTJ passt nicht komplett auf diese Wand. Mach es kleiner oder wähle eine größere Fläche."

                        Status.TextColor3 =
                            Color3.fromRGB(
                                255,
                                120,
                                90
                            )

                        return

                    end

                end

            end

            --------------------------------------------------
            -- START RUN
            --------------------------------------------------

            Painting =
                true

            PaintRun =
                PaintRun + 1

            local run =
                PaintRun

            task.spawn(
                function()

                    local success,
                        errorMessage =
                        pcall(
                            function()

                                paintMSTJ(
                                    run
                                )

                            end
                        )

                    if not success then

                        Painting =
                            false

                        PreviewFolder.Parent =
                            Workspace

                        Status.Text =
                            "ERROR: "
                            .. tostring(
                                errorMessage
                            )

                        Status.TextColor3 =
                            Color3.fromRGB(
                                255,
                                90,
                                90
                            )

                        warn(
                            "[MSTJ AUTO PAINTER]",
                            errorMessage
                        )

                    end

                end
            )

        end
    )

