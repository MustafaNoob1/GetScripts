local function getAppearance()

    local config =
        DrawHandler.DynamicConfig

    local brushSize =
        math.clamp(
            BASE_BRUSH_SIZE
                * Scale,
            0.08,
            3.5
        )

    return {

        BrushSize =
            brushSize,

        PaintLayer =
            math.clamp(
                config.CurrentPaintLayer
                    or 10,
                0,
                100
            ),

        Opacity =
            math.clamp(
                config.CurrentOpacity
                    or 1,
                0,
                1
            ),

        Color =
            PAINT_COLOR,

        Material =
            config.CurrentMaterial
            or "Plastic",

        Owner =
            Player

    }

end

