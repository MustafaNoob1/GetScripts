function BR.isActuallyVisible(object)
    if not object or not object.Parent then
        return false
    end

    local current = object

    while current and current ~= game do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end

        if current:IsA("ScreenGui") and not current.Enabled then
            return false
        end

        current = current.Parent
    end

    if object:IsA("GuiObject") then
        if object.AbsoluteSize.X < 5 or object.AbsoluteSize.Y < 5 then
            return false
        end
    end

    return true
end

function BR.buttonTexts(button)
    local result = {}

    if button:IsA("TextButton") and BR.norm(button.Text) ~= "" then
        table.insert(result, button.Text)
    end

    for _, object in ipairs(button:GetDescendants()) do
        if (object:IsA("TextLabel") or object:IsA("TextButton"))
            and object.Visible
            and type(object.Text) == "string"
            and BR.norm(object.Text) ~= "" then
            table.insert(result, object.Text)
        end
    end

    return result
end

function BR.currentVisibleEvent()
    local best = nil
    local bestLength = 0

    for _, object in ipairs(BR.PlayerGui:GetDescendants()) do
        if (object:IsA("TextLabel") or object:IsA("TextButton"))
            and BR.isActuallyVisible(object)
            and type(object.Text) == "string" then

            local eventInfo = BR.resolveEventTitle(object.Text)

            if eventInfo then
                local length = #BR.norm(object.Text)

                if length > bestLength then
                    best = eventInfo
                    bestLength = length
                end
            end
        end
    end

    return best
end

function BR.bestVisibleChoice()
    local best = nil
    local currentEvent = BR.currentVisibleEvent()

    local info = {
        Known = 0,
        Affordable = 0,
        Unaffordable = 0,
        Disabled = 0,
        Blocked = 0,
        Event = currentEvent
    }

    for _, object in ipairs(BR.PlayerGui:GetDescendants()) do
        if object:IsA("GuiButton") and BR.isActuallyVisible(object) then
            local texts = BR.buttonTexts(object)
            local matched = nil
            local matchedText = nil

            for _, buttonText in ipairs(texts) do
                local entries = BR.resolveChoiceText(buttonText)

                if entries then
                    matched = entries
                    matchedText = buttonText
                    break
                end
            end

            if matched then
                for _, entry in ipairs(matched) do
                    -- V1 could associate a reused choice text with the wrong
                    -- event. V2 first detects the visible event title and then
                    -- only evaluates choices belonging to that exact event.
                    if not currentEvent or entry.Event == currentEvent then
                        info.Known = info.Known + 1

                        local candidate, skipType =
                            BR.evaluateChoice(entry.Choice, object, entry.Event)

                        if candidate then
                            candidate.Text = matchedText or entry.Choice.text
                            info.Affordable = info.Affordable + 1

                            if BR.betterCandidate(candidate, best) then
                                best = candidate
                            end
                        elseif skipType == "unaffordable" then
                            info.Unaffordable = info.Unaffordable + 1
                        elseif skipType == "disabled" then
                            info.Disabled = info.Disabled + 1
                        elseif skipType == "blocked" then
                            info.Blocked = info.Blocked + 1
                        end
                    end
                end
            end
        end
    end

    BR.LastScanInfo = info
    return best
end

