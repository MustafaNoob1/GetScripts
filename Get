--------------------------------------------------
-- FUNCTION INTROSPECTION
--------------------------------------------------

local function dumpFunction(file, label, fn)
    if type(fn) ~= "function" then
        return
    end

    local name, source, line = "", "", ""

    if type(debug) == "table" and type(debug.info) == "function" then
        pcall(function()
            name = tostring(debug.info(fn, "n") or "")
            source = tostring(debug.info(fn, "s") or "")
            line = tostring(debug.info(fn, "l") or "")
        end)
    end

    append(
        file,
        "FUNCTION",
        label,
        "name=" .. name,
        "source=" .. source,
        "line=" .. line
    )

    if type(getconstants) == "function" then
        local ok, constants = pcall(getconstants, fn)
        if ok then
            append(
                file,
                "CONSTANTS=",
                clip(serialize(constants), 25000)
            )
        end
    end

    if type(getupvalues) == "function" then
        local ok, upvalues = pcall(getupvalues, fn)
        if ok then
            append(
                file,
                "UPVALUES=",
                clip(serialize(upvalues), 50000)
            )
        end
    end

    if type(getprotos) == "function" then
        local ok, protos = pcall(getprotos, fn)
        if ok and type(protos) == "table" then
            local meta = {}

            for i, proto in ipairs(protos) do
                if i > 50 then
                    break
                end

                local pName, pSource = "", ""
                if type(debug) == "table"
                    and type(debug.info) == "function" then
                    pcall(function()
                        pName = tostring(debug.info(proto, "n") or "")
                        pSource = tostring(debug.info(proto, "s") or "")
                    end)
                end

                table.insert(meta, {
                    index = i,
                    name = pName,
                    source = pSource,
                })
            end

            append(file, "PROTOS=", serialize(meta))
        end
    end
end

local function walkFunctions(file, label, value, depth, seen)
    depth = depth or 0
    seen = seen or {}

    if depth > 8 then
        return
    end

    if type(value) == "function" then
        dumpFunction(file, label, value)
        return
    end

    if type(value) ~= "table" or seen[value] then
        return
    end
    seen[value] = true

    for k, v in pairs(value) do
        local child = label .. "." .. tostring(k)
        if type(v) == "function" then
            dumpFunction(file, child, v)
        elseif type(v) == "table" then
            walkFunctions(file, child, v, depth + 1, seen)
        end
    end
end

--------------------------------------------------
-- RELEVANT MODULES
--------------------------------------------------

stage("1/5 Requiring relevant config/data modules")

local wantedNames = {
    ["BuyMaxCategories"] = true,
    ["Upgrades"] = true,
    ["Resets"] = true,
    ["Stats"] = true,
    ["GameConfig"] = true,
    ["Shop"] = true,
    ["Reveals"] = true,
    ["Achievements"] = true,
    ["Challenges"] = true,
    ["QuestRewards"] = true,
    ["Quests"] = true,
    ["Portals"] = true,
    ["Formulas"] = true,
    ["Remotes"] = true,
    ["DataTemplate"] = true,
    ["SettingsDataTemplate"] = true,
}

local modules = {}

for _, object in ipairs(ReplicatedStorage:GetDescendants()) do
    if object:IsA("ModuleScript") then
        if wantedNames[object.Name] or relevant(fullName(object)) then
            table.insert(modules, object)
        end
    end
end

table.sort(modules, function(a, b)
    return fullName(a) < fullName(b)
end)

section(M.Files.Config, "REQUIRED MODULE RETURNS")

local requiredCount = 0

for index, module in ipairs(modules) do
    append(M.Files.Config, "")
    append(M.Files.Config, "------------------------------------------------------------")
    append(M.Files.Config, "MODULE", index, fullName(module))
    append(M.Files.Config, "------------------------------------------------------------")

    local ok, result = pcall(require, module)

    if ok then
        requiredCount += 1
        append(
            M.Files.Config,
            "RETURN=",
            clip(serialize(result), 150000)
        )

        walkFunctions(
            M.Files.Config,
            fullName(module),
            result,
            0,
            {}
        )
    else
        append(M.Files.Config, "REQUIRE_ERROR=", tostring(result))
    end

    task.wait()
end

append(M.Files.Summary, "Required modules:", requiredCount, "/", #modules)

--------------------------------------------------
-- STATE TEMPLATES / LIVE VALUE OBJECTS
--------------------------------------------------

stage("2/5 State/templates/value objects")

section(M.Files.State, "PLAYER + REPLICATED STATE CANDIDATES")

local stateCount = 0
local stateRoots = {
    player,
    ReplicatedStorage,
}

for _, root in ipairs(stateRoots) do
    local objects = {root}
    for _, object in ipairs(root:GetDescendants()) do
        table.insert(objects, object)
    end

    for index, object in ipairs(objects) do
        local path = fullName(object)

        local valueText = ""
        if object:IsA("ValueBase") then
            local ok, value = pcall(function()
                return object.Value
            end)
            if ok then
                valueText = tostring(value)
            end
        end

        local attrs = {}
        pcall(function()
            attrs = object:GetAttributes()
        end)

        local blob =
            path
            .. " "
            .. object.Name
            .. " "
            .. valueText
            .. " "
            .. serialize(attrs)

        if relevant(blob) then
            stateCount += 1
            append(
                M.Files.State,
                stateCount,
                object.ClassName,
                path,
                "VALUE=" .. valueText,
                "ATTRS=" .. clip(serialize(attrs), 10000)
            )
        end

        if index % 1000 == 0 then
            task.wait()
        end
    end
end

append(M.Files.Summary, "State candidates:", stateCount)

