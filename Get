--------------------------------------------------

local function getAppearanceForStroke(stroke)
    local config = DrawHandler.DynamicConfig
    local brushSize =
        math.clamp(
            BASE_BRUSH_SIZE * stroke.brushScale * Scale,
            0.06,
            3.5
        )

    return {
        BrushSize = brushSize,
        PaintLayer = math.clamp((config.CurrentPaintLayer or 10) + stroke.layerOffset, 0, 100),
        Opacity = math.clamp(config.CurrentOpacity or 1, 0, 1),
        Color = stroke.color,
        Material = config.CurrentMaterial or "Plastic",
        Owner = Player
    }
end

local function makeSprayData(position0, position1, appearance)
    return {
        Id = HttpService:GenerateGUID(false),
        Position0 = position0,
        Position1 = position1,
        Normal = Selected.Normal,
        BrushSize = appearance.BrushSize,
        PaintLayer = appearance.PaintLayer,
        Opacity = appearance.Opacity,
        Color = appearance.Color,
        Material = appearance.Material,
        Owner = Player,
        Timestamp = os.clock(),
        Splatter = false
    }
end

local function paintVectorSegment(pointA, pointB, appearance, run)
    local worldA = toWorld(pointA[1], pointA[2], 0)
    local worldB = toWorld(pointB[1], pointB[2], 0)

    if not worldA or not worldB then
        return false
    end

    local delta = worldB - worldA
    local length = delta.Magnitude

    if length < 0.001 then
        return true
    end

    local spacing =
        math.max(
            appearance.BrushSize * 0.25,
            0.1
        )

    local steps =
        math.max(
            1,
            math.ceil(length / spacing)
        )

    if not pointHasSurface(worldA) then
        Status.Text = "STOP: Art geht über die ausgewählte Wand hinaus."
        Status.TextColor3 = Color3.fromRGB(255, 120, 90)
        return false
    end

    local previous = worldA

    DrawHandler:AddSprayToBatch(
        makeSprayData(worldA, worldA, appearance)
    )

    for i = 1, steps do
        if not Painting or run ~= PaintRun then
            return false
        end

        local alpha = i / steps
        local current = worldA + delta * alpha

        local root = getRoot()
        if not root then
            Status.Text = "STOP: Character nicht gefunden."
            return false
        end

        local distance = (current - root.Position).Magnitude
        if distance >= MAX_DRAW_RANGE then
            Status.Text = "STOP: Ein Teil des Tags liegt außerhalb der Paint-Range."
            Status.TextColor3 = Color3.fromRGB(255, 120, 90)
            return false
        end

        if not pointHasSurface(current) then
            Status.Text = "STOP: Ein Teil des Tags liegt außerhalb der Wand."
            Status.TextColor3 = Color3.fromRGB(255, 120, 90)
            return false
        end

        DrawHandler:AddSprayToBatch(
            makeSprayData(previous, current, appearance)
        )

        previous = current

        if i % POINT_CHUNK == 0 then
            task.wait(POINT_DELAY)
        end
    end

    return true
end

local function paintStroke(stroke, run)
    if #stroke.points < 2 then
        return true
    end

    local appearance = getAppearanceForStroke(stroke)

    for i = 1, #stroke.points - 1 do
        local success =
            paintVectorSegment(
                stroke.points[i],
                stroke.points[i + 1],
                appearance,
                run
            )

        if not success then
            return false
        end
    end

    DrawHandler:RenderBatch()
    task.wait(STROKE_DELAY)

    return true
end

local function paintDesign(run)
    Status.Text = "MSTI wird gemalt..."
    Status.TextColor3 = Color3.fromRGB(190, 120, 255)

    PreviewFolder.Parent = nil

    for index, stroke in ipairs(DESIGN) do
        if not Painting or run ~= PaintRun then
            break
        end

        Status.Text =
            string.format(
                "MSTI wird gemalt... %d/%d",
                index,
                #DESIGN
            )

        local success = paintStroke(stroke, run)
        if not success then
            break
        end
    end

    pcall(function()
        DrawHandler:RenderBatch()
    end)

    PreviewFolder.Parent = Workspace
    Painting = false

    if run == PaintRun then
        Status.Text = "✓ Paint-Vorgang beendet"
        Status.TextColor3 = Color3.fromRGB(100, 255, 140)
    end
end

--------------------------------------------------
-- START / STOP
--------------------------------------------------

StartButton.MouseButton1Click:Connect(function()
    if Painting then
        Status.Text = "Es wird bereits gemalt."
        return
    end

    local valid, reason = validateSelectedPosition()
    if not valid then
        Status.Text = reason
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    --------------------------------------------------
    -- check all design points fit on chosen surface
    --------------------------------------------------

    for _, stroke in ipairs(DESIGN) do
        for _, point in ipairs(stroke.points) do
            local worldPoint = toWorld(point[1], point[2], 0)
            if not pointHasSurface(worldPoint) then
                Status.Text = "Das MSTI passt nicht komplett auf diese Wand. Mach es kleiner oder nimm eine größere Fläche."
                Status.TextColor3 = Color3.fromRGB(255, 120, 90)
                return
            end
        end
    end

    Painting = true
    PaintRun += 1

    local run = PaintRun

    task.spawn(function()
        local success, err = pcall(function()
            paintDesign(run)
        end)

        if not success then
            Painting = false
            PreviewFolder.Parent = Workspace
            Status.Text = "ERROR: " .. tostring(err)
            Status.TextColor3 = Color3.fromRGB(255, 90, 90)
            warn("[MSTI AUTO PAINTER]", err)
        end
    end)
end)

StopButton.MouseButton1Click:Connect(function()
    if not Painting then
        Status.Text = "Kein Paint-Vorgang aktiv."
        return
    end

    Painting = false
    PaintRun += 1

    pcall(function()
        DrawHandler:RenderBatch()
    end)

    PreviewFolder.Parent = Workspace

    Status.Text = "■ Gestoppt"
    Status.TextColor3 = Color3.fromRGB(255, 170, 100)
end)

