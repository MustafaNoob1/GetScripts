-- AUTOMATION TARGETED TRACE - PC V3
-- Read-only diagnostic for the automation project.
--
-- Fixes the V2 blind spot: the interesting controllers are ModuleScripts,
-- not LocalScripts. V3 requires/introspects those modules and passively logs
-- the game's OWN outbound remote calls while you perform normal actions.
--
-- It DOES NOT call FireServer/InvokeServer itself and does not buy/reset.
--
-- After running this script, manually do each action ONCE:
--   1) Buy one normal upgrade
--   2) Use Buy Max once
--   3) Press a Keycap once
--   4) Trigger/observe a Star Level gain if possible
--   5) Prestige once
--   6) Steel once
--   7) Space Prestige once
--   8) Loop once
--   9) Supernova once if unlocked
--
-- Then run:
--   getgenv().AutomationTrace:Stop()
--
-- Upload:
--   AUTO_TRACE_Summary.txt
--   AUTO_TRACE_Controllers.txt
--   AUTO_TRACE_WorldUI.txt
--   AUTO_TRACE_Remotes.txt

local T = {}
getgenv().AutomationTrace = T

T.Enabled = true
T.Started = os.clock()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerScripts = player:WaitForChild("PlayerScripts")

T.Files = {
    Summary = "AUTO_TRACE_Summary.txt",
    Controllers = "AUTO_TRACE_Controllers.txt",
    WorldUI = "AUTO_TRACE_WorldUI.txt",
    Remotes = "AUTO_TRACE_Remotes.txt",
}

T.TargetRemoteNames = {
    GetUpgradeInfo = true,
    UpdateUpgrade = true,
    BuyMaxEvent = true,
    BuyOneEvent = true,
    KeycapPressed = true,
    StarExperienceGain = true,
    LoopEvent = true,
    SupernovaEvent = true,
    SupernovaRespecEvent = true,
    UpdateSetting = true,
    TeleportEvent = true,
}

T.ControllerNames = {
    ClientMain = true,
    CurrencyHUDController = true,
    KeycapController = true,
    LoopController = true,
    StarLevelController = true,
    UpgradeInputController = true,
    UpgradeVisualsController = true,
    SettingsController = true,
    SupernovaBoardController = true,
    SupernovaChallengeController = true,
    RevealController = true,
    TeleportUIController = true,
}

T.WorldKeywords = {
    "prestige",
    "steel",
    "spaceprestige",
    "space prestige",
    "loop",
    "supernova",
    "keycap",
