function BR.isActuallyVisible(object)
    if not object or not object.Parent then
        return false
    end

    local current = object

    while current and current ~= game do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end

        if current:IsA("ScreenGui") and not current.Enabled then
            return false
        end

        current = current.Parent
    end

    if object:IsA("GuiObject") then
        if object.AbsoluteSize.X < 5 or object.AbsoluteSize.Y < 5 then
            return false
        end
    end

    return true
end

function BR.buttonTexts(button)
    local result = {}

    if button:IsA("TextButton") and BR.norm(button.Text) ~= "" then
        table.insert(result, button.Text)
    end

    for _, object in ipairs(button:GetDescendants()) do
        if (object:IsA("TextLabel") or object:IsA("TextButton"))
            and object.Visible
            and type(object.Text) == "string"
            and BR.norm(object.Text) ~= "" then
            table.insert(result, object.Text)
        end
    end

    return result
end

function BR.bestVisibleChoice()
    local best = nil

    for _, object in ipairs(BR.PlayerGui:GetDescendants()) do
        if object:IsA("GuiButton") and BR.isActuallyVisible(object) then
            local texts = BR.buttonTexts(object)
            local matched = nil
            local matchedText = nil

            for _, text in ipairs(texts) do
                local entries = BR.resolveChoiceText(text)
                if entries then
                    matched = entries
                    matchedText = text
                    break
                end
            end

            if matched then
                for _, entry in ipairs(matched) do
                    local score, chance, success, fail =
                        BR.choiceScore(entry.Choice, object)

                    if not best or score > best.Score then
                        best = {
                            Button = object,
                            Choice = entry.Choice,
                            Event = entry.Event,
                            Text = matchedText or entry.Choice.text,
                            Score = score,
                            Chance = chance,
                            SuccessScore = success,
                            FailScore = fail
                        }
                    end
                end
            end
        end
    end

    return best
end

