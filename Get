    local ok, mods = pcall(getloadedmodules)
    if ok and type(mods) == "table" then
        for _, m in ipairs(mods) do
            local p = S.norm(S.path(m))
            if p:find("dayfoot",1,true) or p:find("career",1,true) or p:find("soccer",1,true) or p:find("football",1,true) then
                addScript(m, "loaded relevant")
            end
        end
    end
end
for _, getterName in ipairs({"getrunningscripts","getscripts"}) do
