function BR.findScoutEstimate()
    local bestLow = nil
    local bestHigh = nil

    for _, object in ipairs(BR.PlayerGui:GetDescendants()) do
        if (object:IsA("TextLabel") or object:IsA("TextButton"))
            and BR.isActuallyVisible(object)
            and type(object.Text) == "string" then

            local low, high = string.match(
                object.Text,
                "(%d+)%s*[%-%–—]%s*(%d+)"
            )

            low = tonumber(low)
            high = tonumber(high)

            if low and high
                and low >= 40
                and high <= 250
                and low <= high
                and high - low <= 50 then

                local parentText = ""
                local parent = object.Parent

                if parent then
                    for _, sibling in ipairs(parent:GetDescendants()) do
                        if (sibling:IsA("TextLabel") or sibling:IsA("TextButton"))
                            and type(sibling.Text) == "string" then
                            parentText = parentText .. " " .. BR.norm(sibling.Text)
                        end
                    end
                end

                if string.find(parentText, "potential", 1, true)
                    or string.find(parentText, "potenzial", 1, true)
                    or string.find(parentText, "potentiel", 1, true)
                    or string.find(parentText, "potencial", 1, true) then
                    bestLow = low
                    bestHigh = high
                    break
                end
            end
        end
    end

    if bestLow and bestHigh then
        BR.ScoutEstimateLow = bestLow
        BR.ScoutEstimateHigh = bestHigh
    end

    return BR.ScoutEstimateLow, BR.ScoutEstimateHigh
end

function BR.scoreStatTable(tbl, parent)
    if type(tbl) ~= "table" then
        return nil
    end

    local count = 0
    local sum = 0

    for _, key in ipairs(BR.StatKeys) do
        local value = tonumber(tbl[key])
        if value and value >= 0 and value <= 250 then
            count = count + 1
            sum = sum + value
        end
    end

    if count < 5 then
        return nil
    end

    local average = sum / math.max(1, count)

    -- Reject Config weight/mod tables such as 0.1 / 0.2 / 0.3.
    if average < 5 then
        return nil
    end

    local score = count * 100 + average
    local owner = parent or tbl

    local pos =
        BR.validPosition(tbl.pos)
        or BR.validPosition(tbl.position)
        or BR.validPosition(owner.pos)
        or BR.validPosition(owner.position)

    if pos then
        score = score + 500
    end

    for _, key in ipairs({
        "ovr", "overall", "gen",
        "pot", "potential", "truePotential", "potentialMax",
        "age", "rep", "reputation", "luck"
    }) do
        if tonumber(tbl[key]) or tonumber(owner[key]) then
            score = score + 45
        end
    end

    if tonumber(tbl.pot)
        or tonumber(tbl.potential)
        or tonumber(owner.pot)
        or tonumber(owner.potential) then
        score = score + 300
    end

    local money, moneySource = BR.moneyFromTables(tbl, owner)
    if money ~= nil then
        score = score + 250
    end

    return {
        Score = score,
        Stats = tbl,
        Owner = owner,
        Position = pos,
        Money = money,
        MoneySource = moneySource
    }
end

function BR.findStats()
    if type(getgc) ~= "function" then
        return BR.Stats
    end

    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then
        return BR.Stats
    end

    local best = nil

    local function consider(tbl, parent)
        local candidate = BR.scoreStatTable(tbl, parent)
        if candidate and (not best or candidate.Score > best.Score) then
            best = candidate
        end
    end

    for _, object in ipairs(objects) do
        if type(object) == "table" then
            consider(object, object)

            -- Current career/player state is frequently nested one level deep.
            for key, value in pairs(object) do
                if type(value) == "table" then
                    local k = BR.norm(key)

                    if k == "stats"
                        or k == "player"
                        or k == "career"
                        or k == "profile"
                        or k == "data"
                        or k == "state" then
                        consider(value, object)
                    end
                end
            end
        end
    end

    if best then
        BR.Stats = best.Stats
        BR.StatsOwner = best.Owner
        BR.DetectedPosition = best.Position or BR.DetectedPosition

        if best.Money ~= nil then
            BR.CurrentMoney = best.Money
            BR.MoneySource = "career." .. tostring(best.MoneySource or "money")
        end
    end

    BR.currentMoney()
    BR.refreshCareerMeta()
    return BR.Stats
end

function BR.currentPosition()
    if BR.PositionMode ~= "Auto" then
        return BR.validPosition(BR.PositionMode)
    end

    if BR.DetectedPosition then
        return BR.DetectedPosition
    end

    -- Last fallback: look for a visible standalone position label.
    for _, object in ipairs(BR.PlayerGui:GetDescendants()) do
        if object:IsA("TextLabel") and object.Visible then
            local pos = BR.validPosition(object.Text)
            if pos then
                return pos
            end
        end
    end

    return nil
end

