--------------------------------------------------
-- RAYCAST
--------------------------------------------------

local function raycastMouse()

    local mouse =
        UserInputService:GetMouseLocation()

    local inset =
        GuiService:GetGuiInset()

    mouse -= inset

    local ray =
        Camera:ViewportPointToRay(
            mouse.X,
            mouse.Y
        )

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    local ignore = {
        PreviewFolder
    }

    if Player.Character then

        table.insert(
            ignore,
            Player.Character
        )

    end

    local spray =
        Workspace:FindFirstChild(
            "SprayPaint"
        )

    if spray then

        table.insert(
            ignore,
            spray
        )

    end

    params.FilterDescendantsInstances =
        ignore

    params.RespectCanCollide = false

    return Workspace:Raycast(
        ray.Origin,
        ray.Direction * 500,
        params
    )

end

--------------------------------------------------
-- WALL BASIS
--------------------------------------------------

local function makeBasis(normal)

    normal = normal.Unit

    local worldUp =
        Vector3.new(0, 1, 0)

    local right =
        worldUp:Cross(normal)

    if right.Magnitude < 0.01 then

        right =
            Camera.CFrame.RightVector

        right =
            right
            - normal
            * right:Dot(normal)

    end

    right = right.Unit

    local up =
        normal:Cross(right).Unit

    return right, up

end

--------------------------------------------------
-- ROTATED BASIS
--------------------------------------------------

local function getRotatedBasis()

    local angle =
        math.rad(Rotation)

    local right =
        Selected.Right
        * math.cos(angle)
        + Selected.Up
        * math.sin(angle)

    local up =
        Selected.Up
        * math.cos(angle)
        - Selected.Right
        * math.sin(angle)

    return right, up

end

--------------------------------------------------
-- LOCAL 2D -> WORLD
--------------------------------------------------

local function toWorld(x, y)

    local right, up =
        getRotatedBasis()

    local width =
        BaseWidth * Scale

    local height =
        BaseHeight * Scale

    return
        Selected.Position
        + Selected.Normal * 0.045
        + right * (x * width)
        + up * (y * height)

end

--------------------------------------------------
-- PREVIEW SEGMENT
--------------------------------------------------

local function previewLine(a, b)

    local delta =
        b - a

    local length =
        delta.Magnitude

    if length < 0.001 then
        return
    end

    local line =
        Instance.new("Part")

    line.Name =
        "MSTJPreviewLine"

    line.Anchored = true
    line.CanCollide = false
    line.CanQuery = false
    line.CanTouch = false

    line.CastShadow = false

    line.Material =
        Enum.Material.Neon

    line.Color =
        Color3.fromRGB(
            176,
            75,
            255
        )

    line.Transparency =
        0.18

    line.Size =
        Vector3.new(
            0.14 * Scale,
            0.14 * Scale,
            length
        )

    line.CFrame =
        CFrame.lookAt(
            (a + b) / 2,
            b,
            Selected.Normal
        )

    line.Parent =
        PreviewFolder

end

--------------------------------------------------
-- DRAW ART PREVIEW
--------------------------------------------------

local function updatePreview()

    PreviewFolder:ClearAllChildren()

    TransformInfo.Text =
        string.format(
            "Größe: %d%%     Rotation: %d°",
            math.floor(Scale * 100),
            Rotation
        )

    if not Selected then
        return
    end

    for _, stroke in ipairs(ART) do

        for i = 1, #stroke - 1 do

            local p0 =
                stroke[i]

            local p1 =
                stroke[i + 1]

            previewLine(
                toWorld(
                    p0[1],
                    p0[2]
                ),
                toWorld(
                    p1[1],
                    p1[2]
                )
            )

        end

    end

end

