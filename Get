                    pcall(function()
                        BR.Fluent:Notify({
                            Title = "Auto Best Choice",
                            Content = tostring(best.Choice.text)
                                .. (best.Chance
                                    and (" | " .. tostring(math.floor(best.Chance)) .. "%")
                                    or "")
                                .. " | worst "
                                .. string.format("%+.2f", best.WorstRating or 0),
                            Duration = 2
                        })
                    end)
                elseif reason
                    and reason ~= "click cooldown" then
                    warn("[BestRating] choice skipped:", reason)
                end
            end
        end
    end
end)

function BR:Stop()
    self.Alive = false
    self.AutoChoice = false
    self.AutoIdentity = false

    pcall(function()
        self.Window:Destroy()
    end)
end

