function BR.bestIdentity()
    local position = BR.currentPosition()
    if not position then
        return nil
    end

    local identities = BR.Config.IDENTITIES
    if type(identities) ~= "table" then
        return nil
    end

    local list = identities[position]
    if type(list) ~= "table" then
        return nil
    end

    local best = nil

    for _, identity in ipairs(list) do
        local perks = identity.perks or {}
        local rating = tonumber(perks.rating) or 0

        -- Rating is primary. Tiebreak with useful output perks.
        local tie =
            (tonumber(perks.goals) or 0)
            + (tonumber(perks.assists) or 0)
            + (tonumber(perks.cs) or 0)

        local value = rating * 1000 + tie

        if not best or value > best.Value then
            best = {
                Identity = identity,
                Rating = rating,
                Value = value,
                Position = position
            }
        end
    end

    return best
end

function BR.findVisibleButtonByText(targetText)
    local target = BR.norm(targetText)

    for _, object in ipairs(BR.PlayerGui:GetDescendants()) do
        if object:IsA("GuiButton") and BR.isActuallyVisible(object) then
            for _, text in ipairs(BR.buttonTexts(object)) do
                if BR.norm(text) == target then
                    return object
                end
            end
        end
    end

    return nil
end

