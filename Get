-- MAIN LOOP
--------------------------------------------------

task.spawn(function()
    while BR.Alive do
        task.wait(BR.ScanDelay)

        if os.clock() - BR.LastStatsScan > 4 then
            BR.LastStatsScan = os.clock()
            pcall(BR.findStats)
        end

        local best = nil
        pcall(function()
            best = BR.bestVisibleChoice()
        end)

        BR.LastBest = best

        pcall(function()
            BR.StatusParagraph:SetDesc(BR.bestText(best))
            BR.IdentityParagraph:SetDesc(BR.identityText())

            BR.DebugParagraph:SetDesc(
                "Indexed choice texts: "
                    .. tostring((function()
                        local n = 0
                        for _ in pairs(BR.ChoiceIndex) do
                            n = n + 1
                        end
                        return n
                    end)())
                    .. "\nPosition: " .. tostring(BR.currentPosition() or "-")
                    .. "\n" .. BR.statsText()
                    .. "\nFocus: " .. tostring(BR.FocusMode)
                    .. " | Risk: " .. tostring(BR.RiskMode)
            )
        end)

        if BR.AutoIdentity then
            local identity = BR.bestIdentity()

            if identity and identity.Identity and identity.Identity.name then
                local button = BR.findVisibleButtonByText(identity.Identity.name)

                if button
                    and (button ~= BR.LastClickButton
                        or os.clock() - BR.LastClickAt > 2) then
                    BR.LastClickButton = button
                    BR.LastClickAt = os.clock()
                    BR.click(button)
                end
            end
        end

        if BR.AutoChoice and best and best.Button then
            if best.Button ~= BR.LastClickButton
                or os.clock() - BR.LastClickAt > 2 then
                BR.LastClickButton = best.Button
                BR.LastClickAt = os.clock()

                local ok = BR.click(best.Button)

                if ok then
                    pcall(function()
                        BR.Fluent:Notify({
                            Title = "Auto Best Choice",
                            Content = tostring(best.Choice.text)
                                .. (best.Chance
                                    and (" | " .. tostring(math.floor(best.Chance)) .. "%")
                                    or ""),
                            Duration = 2
                        })
                    end)
                end
            end
        end
    end
end)

function BR:Stop()
    self.Alive = false
    self.AutoChoice = false
    self.AutoIdentity = false

    pcall(function()
        self.Window:Destroy()
    end)
end

BR.findStats()
BR.Window:SelectTab(1)

warn(
    "[BestRating] V1 ready | choices:",
    tostring((function()
        local n = 0
        for _ in pairs(BR.ChoiceIndex) do
            n = n + 1
        end
        return n
    end)())
)
