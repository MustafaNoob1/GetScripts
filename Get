--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function now()
    return os.date("!%Y-%m-%dT%H:%M:%SZ")
end

local function resetFile(name)
    if type(writefile) == "function" then
        pcall(writefile, name, "")
    end
end

local function append(name, ...)
    local parts = {}

    for i = 1, select("#", ...) do
        parts[i] = tostring(select(i, ...))
    end

    local line = table.concat(parts, " ") .. "\n"

    if type(appendfile) == "function" then
        local ok = pcall(appendfile, name, line)
        if ok then
            return
        end
    end

    local old = ""

    if type(isfile) == "function"
        and type(readfile) == "function" then
        pcall(function()
            if isfile(name) then
                old = readfile(name)
            end
        end)
    end

    if type(writefile) == "function" then
        pcall(writefile, name, old .. line)
    end
end

local function section(name, title)
    append(name, "")
    append(name, "============================================================")
    append(name, title)
    append(name, "============================================================")
end

local function fullName(inst)
    local ok, result = pcall(function()
        return inst:GetFullName()
    end)

    return ok and tostring(result) or tostring(inst)
end

local function clip(value, limit)
    local s = tostring(value or "")
    limit = limit or 5000

    if #s > limit then
        return s:sub(1, limit) .. "...<truncated>"
    end

    return s
end

local function serialize(value, depth, seen)
    depth = depth or 0
    seen = seen or {}

    if depth > 8 then
        return "<max-depth>"
    end

    local t = typeof(value)

    if t == "nil" then
        return "nil"
    elseif t == "string" then
        return string.format("%q", clip(value, 6000))
    elseif t == "number" or t == "boolean" then
        return tostring(value)
    elseif t == "Instance" then
        return "<Instance " .. fullName(value) .. ">"
    elseif t == "function" then
        local n, s = "", ""

        if type(debug) == "table"
            and type(debug.info) == "function" then
            pcall(function()
                n = tostring(debug.info(value, "n") or "")
                s = tostring(debug.info(value, "s") or "")
            end)
        end

        return "<function name=" .. n .. " source=" .. s .. ">"
    elseif t ~= "table" then
        return "<" .. t .. " " .. clip(value, 800) .. ">"
    end

    if seen[value] then
        return "<cycle>"
    end

    seen[value] = true

    local out = {}
    local count = 0

    for k, v in pairs(value) do
        count += 1

        if count > 800 then
            table.insert(out, "<table-capped>")
            break
        end

        table.insert(
            out,
            "["
                .. serialize(k, depth + 1, seen)
                .. "]="
                .. serialize(v, depth + 1, seen)
        )
    end

    seen[value] = nil

    return "{" .. table.concat(out, ",") .. "}"
end

local function interestingName(value)
    local s = string.lower(tostring(value or ""))

    for _, keyword in ipairs(T.WorldKeywords) do
        if string.find(s, keyword, 1, true) then
            return true
        end
    end

    return false
end

for _, file in pairs(T.Files) do
    resetFile(file)
end

