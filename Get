function BR.statImpact(key, amount)
    amount = tonumber(amount) or 0
    local position = BR.currentPosition()
    local weights = BR.PositionWeights[position] or {}
    local weight = weights[key] or 0

    if key == "technique" then
        local total = (weights.tir or 0) + (weights.passe or 0) + (weights.dribble or 0)
        weight = total / 3
    elseif key == "physique" then
        local total = (weights.vitesse or 0) + (weights.puissance or 0) + (weights.defense or 0)
        weight = total / 3
    end

    if BR.FocusMode == "Career Max" then
        return amount * (10 + weight * 90)
    end

    return amount * (3 + weight * 35)
end

function BR.effectScore(effects)
    if type(effects) ~= "table" then
        return 0
    end

    local score = 0

    -- Direct match-rating change dominates Rating Focus.
    local ratingWeight = BR.FocusMode == "Rating Focus" and 1000 or 420
    score = score + (tonumber(effects.ratingDelta) or 0) * ratingWeight

    -- Match actions that usually feed the rating/result indirectly.
    if effects.goal == true then score = score + 180 end
    if effects.assist == true then score = score + 130 end
    if effects.save == true then score = score + 150 end
    if effects.cleanSheet == true or effects.cs == true then score = score + 120 end
    if effects.concede == true then score = score - 180 end
    if effects.red == true or effects.redCard == true then score = score - 220 end
    if effects.injury then score = score - math.abs(tonumber(effects.injury) or 1) * 45 end

    for _, stat in ipairs(BR.StatKeys) do
        if effects[stat] ~= nil then
            score = score + BR.statImpact(stat, effects[stat])
        end
    end

    if effects.technique ~= nil then
        score = score + BR.statImpact("technique", effects.technique)
    end

    if effects.physique ~= nil then
        score = score + BR.statImpact("physique", effects.physique)
    end

    local careerMultiplier = BR.FocusMode == "Career Max" and 1.8 or 1

    score = score + (tonumber(effects.xp) or 0) * 1.4 * careerMultiplier
    score = score + (tonumber(effects.forme) or 0) * 8 * careerMultiplier
    score = score + (tonumber(effects.moral) or 0) * 4 * careerMultiplier
    score = score + (tonumber(effects.discipline) or 0) * 7 * careerMultiplier
    score = score + (tonumber(effects.relCoach) or 0) * 5 * careerMultiplier
    score = score + (tonumber(effects.vestiaire) or 0) * 3 * careerMultiplier
    score = score + (tonumber(effects.rep) or 0) * 3 * careerMultiplier

    -- Money matters, but should not override a major rating/stat gain.
    local money = tonumber(effects.money) or 0
    if money ~= 0 then
        score = score + math.clamp(money / 5000, -20, 20)
    end

    return score
end

--------------------------------------------------
-- ROLL CHANCE + CHOICE SCORE
--------------------------------------------------

function BR.parseChanceFromButton(button)
    if not button then
        return nil
    end

    local texts = {}

    if button:IsA("TextButton") then
        table.insert(texts, button.Text)
    end

    for _, object in ipairs(button:GetDescendants()) do
        if (object:IsA("TextLabel") or object:IsA("TextButton"))
            and object.Visible
            and type(object.Text) == "string" then
            table.insert(texts, object.Text)
        end
    end

    for _, text in ipairs(texts) do
        local value = string.match(text, "(%d+)%s*%%")
        if value then
            local n = tonumber(value)
            if n and n >= 0 and n <= 100 then
                return n
            end
        end
    end

    return nil
end

function BR.rollChance(choice, button)
    if type(choice) ~= "table" or type(choice.roll) ~= "table" then
        return nil
    end

    local displayed = BR.parseChanceFromButton(button)
    if displayed then
        return displayed
    end

    local stats = BR.Stats or BR.findStats()

    if stats and type(BR.Config.rollChance) == "function" then
        local ok, chance = pcall(
            BR.Config.rollChance,
            stats,
            choice.roll.stat,
            choice.roll.dc
        )

        if ok and tonumber(chance) then
            return math.clamp(tonumber(chance), 0, 100)
        end
    end

    return 50
end

function BR.choiceScore(choice, button)
    local base = BR.effectScore(choice.effects)

    if type(choice.roll) ~= "table" then
        return base, nil, nil, nil
    end

    local chance = BR.rollChance(choice, button) or 50
    local p = chance / 100

    local success = BR.effectScore(choice.success)
    local fail = BR.effectScore(choice.fail)

    local rollScore = 0

    if BR.RiskMode == "Max Upside" then
        rollScore = success
    elseif BR.RiskMode == "Safe" then
        rollScore = math.min(success, fail) * 0.75
            + (success * p + fail * (1 - p)) * 0.25
    else
        rollScore = success * p + fail * (1 - p)
    end

    return base + rollScore, chance, success, fail
end

