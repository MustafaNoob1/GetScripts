}

function S.stateScore(tbl)
    if type(tbl) ~= "table" then
        return 0
    end

    local score = 0

    for _, key in ipairs(S.StateKeys) do
        if rawget(tbl, key) ~= nil then
            score = score + 1
        end
    end

    for _, key in ipairs({
        "tir",
        "passe",
        "dribble",
        "vitesse",
        "puissance",
        "defense",
        "mental"
    }) do
        local value = tonumber(rawget(tbl, key))

        if value and value >= 0 and value <= 250 then
            score = score + 2
        end
    end

    if rawget(tbl, "age") ~= nil then score = score + 4 end
    if rawget(tbl, "position") ~= nil then score = score + 4 end
    if rawget(tbl, "money") ~= nil then score = score + 3 end
    if rawget(tbl, "potMin") ~= nil then score = score + 4 end
    if rawget(tbl, "potMax") ~= nil then score = score + 4 end

    return score
end

function S.optimizer()
    local br = getgenv().BestRatingOptimizer

    if type(br) == "table" and br.Alive ~= false then
        return br
    end

    return nil
end

function S.stateFromOptimizer()
    local br = S.optimizer()

    if not br then
        return nil
    end

    local candidates = {
        br.StatsOwner,
        br.Stats
    }

    for _, candidate in ipairs(candidates) do
        if type(candidate) == "table"
            and S.stateScore(candidate) >= 8 then
            return candidate, "BestRatingOptimizer"
        end
    end

    return nil
end

function S.findStateFallback()
    -- Fallback only. This runs at most every ~15 seconds, not every frame.
    if type(getgc) ~= "function" then
        return nil
    end

    if os.clock() - S.LastCareerRefScan < 15 then
        return S.CareerState
    end

    S.LastCareerRefScan = os.clock()

    local ok, objects = pcall(getgc, true)

    if not ok or type(objects) ~= "table" then
        return S.CareerState
    end

    local best = nil
    local bestScore = 0

    for _, object in ipairs(objects) do
        if type(object) == "table" then
            local score = S.stateScore(object)

            if score > bestScore then
                best = object
                bestScore = score
            end
        end
    end

    if bestScore >= 10 then
        S.CareerState = best
        S.CareerStateScore = bestScore
    end

    return S.CareerState
end

function S.currentState()
    local state, source = S.stateFromOptimizer()

    if state then
        S.CareerState = state
        S.CareerStateScore = S.stateScore(state)
        return state, source
    end

    state = S.findStateFallback()

    if state then
        return state, "getgc fallback"
    end

    return nil, "none"
end

function S.numberFrom(state, keys)
    if type(state) ~= "table" then
        return nil
    end

    for _, key in ipairs(keys) do
        local value = tonumber(rawget(state, key))

        if value ~= nil then
            return value
        end
    end

    return nil
end

function S.stateFingerprint(state)
    if type(state) ~= "table" then
        return "none"
    end

    return S.serializeFlat(state, {
        "age",
        "season",
        "position",
        "ovr",
        "overall",
        "peak",
        "peakOverall",
        "pot",
        "potential",
        "potMin",
        "potMax",
        "money",
        "rep",
        "reputation",
        "forme",
        "moral",
        "discipline",
        "tir",
        "passe",
        "dribble",
        "vitesse",
        "puissance",
        "defense",
        "mental",
        "injury",
        "injured",
        "suspend",
        "playstyle"
    })
end

function S.captureState(reason)
    local state, source = S.currentState()

    if not state then
        return
    end

    local overall = S.numberFrom(state, {
        "ovr",
        "overall",
        "gen"
    })

    local peak = S.numberFrom(state, {
        "peak",
        "peakOverall",
        "careerPeak"
    }) or overall

    local age = S.numberFrom(state, {"age"})

    if overall ~= nil then
        S.MinOverall = S.MinOverall == nil
            and overall
            or math.min(S.MinOverall, overall)

        S.MaxOverall = S.MaxOverall == nil
            and overall
            or math.max(S.MaxOverall, overall)

        S.StartOverall = S.StartOverall or overall
        S.EndOverall = overall
    end

    if peak ~= nil then
        S.MaxPeak = S.MaxPeak == nil
            and peak
            or math.max(S.MaxPeak, peak)
    end

    if age ~= nil then
        S.StartAge = S.StartAge or age
        S.EndAge = age
    end

    S.log(
        "STATE_" .. tostring(reason or "CHANGE"),
        "source="
            .. tostring(source)
            .. " | "
            .. S.stateFingerprint(state)
    )
end

--------------------------------------------------
-- EVENT / DECISION OBSERVATION
--------------------------------------------------

function S.visible(object)
    if not object or not object.Parent then
        return false
    end

    local current = object

    while current and current ~= game do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end

        if current:IsA("ScreenGui") and not current.Enabled then
            return false
        end

        current = current.Parent
    end

    return true
end

function S.currentVisibleEventFallback()
    for _, object in ipairs(S.Gui:GetDescendants()) do
        if (object:IsA("TextLabel") or object:IsA("TextButton"))
            and S.visible(object)
            and type(object.Text) == "string" then

            local event = S.EventTitles[S.norm(object.Text)]

            if event then
                return event
            end
        end
    end

    return nil
end

function S.currentVisibleEvent()
    local br = S.optimizer()

    if br and type(br.currentVisibleEvent) == "function" then
        local ok, event = pcall(br.currentVisibleEvent)

        if ok and type(event) == "table" then
            return event
        end
    end

    return S.currentVisibleEventFallback()
end

function S.currentDecision()
    local br = S.optimizer()

    if br and type(br.LastBest) == "table" then
        local best = br.LastBest
        local event = best.Event

        return {
            EventId = event and event.id or nil,
            EventTitle = event and event.title or nil,
            Choice = best.Choice and best.Choice.text or best.Text,
            Score = best.Score,
            Chance = best.Chance,
            Worst = best.WorstRating,
            Expected = best.ExpectedRating,
            Best = best.BestRating,
            Cost = best.Cost,
            Phase = type(br.careerPhase) == "function"
                and br.careerPhase()
                or nil
        }
    end

    return nil
end

function S.decisionFingerprint(decision)
    if type(decision) ~= "table" then
        return "none"
    end

    return table.concat({
        tostring(decision.EventId),
        tostring(decision.Choice),
        tostring(decision.Score),
        tostring(decision.Chance),
        tostring(decision.Worst),
        tostring(decision.Expected),
        tostring(decision.Best),
        tostring(decision.Cost),
        tostring(decision.Phase)
    }, "|")
end

function S.captureDecision()
    local decision = S.currentDecision()

    if not decision then
        return
    end

    local fp = S.decisionFingerprint(decision)

    if fp == S.LastDecisionFP then
        return
    end

    S.LastDecisionFP = fp

    if decision.EventId then
        S.EventCounts[tostring(decision.EventId)] =
            (S.EventCounts[tostring(decision.EventId)] or 0) + 1
    end

    if decision.Choice then
        S.ChoiceCounts[tostring(decision.Choice)] =
            (S.ChoiceCounts[tostring(decision.Choice)] or 0) + 1
    end

    S.log(
        "DECISION",
        "event="
            .. tostring(decision.EventId or "-")
            .. " | title="
            .. tostring(decision.EventTitle or "-")
            .. " | choice="
            .. tostring(decision.Choice or "-")
            .. " | phase="
            .. tostring(decision.Phase or "-")
            .. " | chance="
            .. tostring(decision.Chance or "-")
            .. " | rating(w/e/b)="
            .. tostring(decision.Worst or "-")
            .. "/"
            .. tostring(decision.Expected or "-")
            .. "/"
            .. tostring(decision.Best or "-")
            .. " | score="
            .. tostring(decision.Score or "-")
            .. " | cost="
            .. tostring(decision.Cost or 0)
    )
end

function S.captureEvent()
    local event = S.currentVisibleEvent()
    local fp = event and tostring(event.id) or "none"

    if fp == S.LastEventFP then
        return
    end

    S.LastEventFP = fp

    if event then
        S.log(
            "EVENT",
            "id="
                .. tostring(event.id)
                .. " | title="
                .. tostring(event.title)
        )
    end
end

function S.capturePolicy()
    local br = S.optimizer()

    if not br then
        return
    end

    local action = tostring(br.LastPolicyAction or "-")
    local at = tostring(br.LastPolicyAt or 0)
    local fp = action .. "|" .. at

    if fp == S.LastPolicyFP then
        return
    end

    S.LastPolicyFP = fp

    if action ~= "-" then
        S.PolicyCounts[action] =
            (S.PolicyCounts[action] or 0) + 1

        S.log(
            "POLICY",
            action
                .. " | phase="
                .. tostring(
                    type(br.careerPhase) == "function"
                        and br.careerPhase()
                        or "-"
                )
        )
    end
end

--------------------------------------------------
-- SUMMARY
--------------------------------------------------

function S.sortedCounts(map)
    local rows = {}

    for key, value in pairs(map) do
        table.insert(rows, {
            Key = key,
            Value = value
        })
    end

    table.sort(rows, function(a, b)
        if a.Value ~= b.Value then
            return a.Value > b.Value
        end

        return tostring(a.Key) < tostring(b.Key)
    end)

    return rows
end

function S.makeSummary()
    local out = {
        "============================================================",
        "GOAT SCAN LITE SUMMARY",
        "============================================================",
        "Started UTC: " .. os.date("!%Y-%m-%dT%H:%M:%SZ", S.StartedAt),
        "Finished UTC: " .. S.ts(),
        "PlaceId: " .. tostring(game.PlaceId),
        "GameId: " .. tostring(game.GameId),
        "",
        "Start age: " .. tostring(S.StartAge or "-"),
        "End age: " .. tostring(S.EndAge or "-"),
        "Start overall: " .. tostring(S.StartOverall or "-"),
        "End overall: " .. tostring(S.EndOverall or "-"),
        "Max observed overall: " .. tostring(S.MaxOverall or "-"),
        "Max observed peak: " .. tostring(S.MaxPeak or "-"),
        "",
        "EVENT COUNTS"
    }

    for _, row in ipairs(S.sortedCounts(S.EventCounts)) do
        table.insert(
            out,
            tostring(row.Value) .. "x | " .. tostring(row.Key)
        )
    end

    table.insert(out, "")
    table.insert(out, "CHOICE COUNTS")

    for _, row in ipairs(S.sortedCounts(S.ChoiceCounts)) do
        table.insert(
            out,
            tostring(row.Value) .. "x | " .. tostring(row.Key)
        )
    end

    table.insert(out, "")
    table.insert(out, "POLICY ACTIONS")

    for _, row in ipairs(S.sortedCounts(S.PolicyCounts)) do
        table.insert(
            out,
            tostring(row.Value) .. "x | " .. tostring(row.Key)
        )
    end

    return table.concat(out, "\n")
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

S.log(
    "START",
    "V2 LITE | polling="
        .. tostring(S.PollEvery)
        .. "s | heavy scans disabled"
)

S.captureState("INITIAL")
S.captureEvent()
S.captureDecision()
S.capturePolicy()
S.flush()

task.spawn(function()
    while S.Alive do
        task.wait(S.PollEvery)

        local state = S.currentState()
        local stateFP = S.stateFingerprint(state)

        if stateFP ~= S.LastStateFP then
            S.LastStateFP = stateFP
            S.captureState("CHANGE")
        end

        S.captureEvent()
        S.captureDecision()
        S.capturePolicy()

        if os.clock() - S.LastFlush >= S.FlushEvery then
            S.flush()
        end
    end
end)

--------------------------------------------------
-- CONTROL
--------------------------------------------------

function S:Snapshot(label)
    self.log(
        "MANUAL",
        tostring(label or "snapshot")
    )

    self.captureState("MANUAL")
    self.captureEvent()
    self.captureDecision()
    self.capturePolicy()
    self.flush()
end

function S:Stop()
    if not self.Alive then
        return
    end

    self.Alive = false

    self.captureState("FINAL")
    self.captureEvent()
    self.captureDecision()
    self.capturePolicy()
    self.flush()

    self.write(
        "GOATScan_LiteSummary.txt",
        self.makeSummary()
    )

    warn("[GOATScanner] V2 LITE STOPPED")
    warn("[GOATScanner] Upload:")
    warn("GOATScan_LiteTelemetry.txt")
    warn("GOATScan_LiteSummary.txt")
end

task.delay(90 * 60, function()
    if S.Alive then
        S:Stop()
    end
end)

warn("[GOATScanner] V2 LITE READY")
warn("[GOATScanner] Recommended order: run V6 first, then this scanner.")
warn("[GOATScanner] At career end:")
warn("getgenv().GOATResearchScanner:Stop()")
