S.EventTitles, S.ChoiceTexts = {}, {}
function S.indexEvents(node, seen)
    if type(node) ~= "table" then return end
    seen = seen or {}
    if seen[node] then return end
    seen[node] = true
    if type(node.id) == "string" and type(node.title) == "string" and type(node.choices) == "table" then
        S.EventTitles[S.norm(node.title)] = node
        for i, choice in ipairs(node.choices) do
            if type(choice) == "table" and type(choice.text) == "string" then
                local k = S.norm(choice.text)
                S.ChoiceTexts[k] = S.ChoiceTexts[k] or {}
                table.insert(S.ChoiceTexts[k], {Event=node, Choice=choice, Index=i})
            end
        end
    end
    for k, x in pairs(node) do
        if type(x) == "table" and k ~= "choices" then S.indexEvents(x, seen) end
    end
end
if S.Events then S.indexEvents(S.Events, {}) end

