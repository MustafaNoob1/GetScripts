--------------------------------------------------
-- TEXT HELPERS
--------------------------------------------------

function BR.norm(value)
    local s = tostring(value or "")
    s = string.lower(s)

    -- Normalize smart punctuation that often differs between locale/UI text.
    s = string.gsub(s, "’", "'")
    s = string.gsub(s, "“", "\"")
    s = string.gsub(s, "”", "\"")
    s = string.gsub(s, "–", "-")
    s = string.gsub(s, "—", "-")

    -- Remove rich-text tags and collapse whitespace.
    s = string.gsub(s, "<.->", " ")
    s = string.gsub(s, "%s+", " ")
    s = string.gsub(s, "^%s+", "")
    s = string.gsub(s, "%s+$", "")

    return s
end

function BR.short(value)
    local n = tonumber(value)
    if n == nil then
        return tostring(value or "-")
    end

    if math.abs(n) >= 1000000000 then
        return string.format("%.2fB", n / 1000000000)
    elseif math.abs(n) >= 1000000 then
        return string.format("%.2fM", n / 1000000)
    elseif math.abs(n) >= 1000 then
        return string.format("%.1fK", n / 1000)
    end

    if math.abs(n - math.floor(n)) < 0.001 then
        return tostring(math.floor(n))
    end

    return string.format("%.2f", n)
end

