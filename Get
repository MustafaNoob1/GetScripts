--------------------------------------------------
-- MOUSE RAYCAST
--------------------------------------------------

local function raycastMouse()

    local mousePosition =
        UserInputService
            :GetMouseLocation()

    local inset =
        GuiService:GetGuiInset()

    mousePosition =
        mousePosition
        - inset

    local ray =
        Camera:ViewportPointToRay(
            mousePosition.X,
            mousePosition.Y
        )

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.RespectCanCollide =
        false

    local ignore = {
        PreviewFolder
    }

    if Player.Character then

        table.insert(
            ignore,
            Player.Character
        )

    end

    local sprayPaint =
        Workspace
            :FindFirstChild(
                "SprayPaint"
            )

    if sprayPaint then

        table.insert(
            ignore,
            sprayPaint
        )

    end

    params.FilterDescendantsInstances =
        ignore

    return Workspace:Raycast(
        ray.Origin,
        ray.Direction * 500,
        params
    )

end

--------------------------------------------------
-- CREATE WALL BASIS
--------------------------------------------------

local function makeBasis(
    normal
)

    normal =
        normal.Unit

    local worldUp =
        Vector3.new(
            0,
            1,
            0
        )

    local right =
        worldUp:Cross(
            normal
        )

    --------------------------------------------------
    -- CEILING / FLOOR FALLBACK
    --------------------------------------------------

    if right.Magnitude
        < 0.01 then

        right =
            Camera.CFrame.RightVector

        right =
            right
            - normal
            * right:Dot(normal)

    end

    right =
        right.Unit

    local up =
        normal:Cross(
            right
        ).Unit

    return right, up

end

--------------------------------------------------
-- ROTATED BASIS
--------------------------------------------------

local function getRotatedBasis()

    local angle =
        math.rad(
            Rotation
        )

    local cosine =
        math.cos(
            angle
        )

    local sine =
        math.sin(
            angle
        )

    local right =
        Selected.Right
        * cosine
        + Selected.Up
        * sine

    local up =
        Selected.Up
        * cosine
        - Selected.Right
        * sine

    return right, up

end

--------------------------------------------------
-- 2D ART -> WORLD
--------------------------------------------------

local function toWorld(
    x,
    y,
    normalOffset
)

    if not Selected then
        return nil
    end

    normalOffset =
        normalOffset
        or 0

    local right,
        up =
        getRotatedBasis()

    local width =
        BASE_WIDTH
        * Scale

    local height =
        BASE_HEIGHT
        * Scale

    return
        Selected.Position
        + right
        * (
            x
            * width
        )
        + up
        * (
            y
            * height
        )
        + Selected.Normal
        * normalOffset

end

--------------------------------------------------
-- CHECK WHETHER POINT STILL HAS WALL BEHIND IT
--------------------------------------------------

local function pointHasSurface(
    point
)

    if not Selected then
        return false
    end

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    local ignore = {
        PreviewFolder
    }

    if Player.Character then

        table.insert(
            ignore,
            Player.Character
        )

    end

    local sprayPaint =
        Workspace
            :FindFirstChild(
                "SprayPaint"
            )

    if sprayPaint then

        table.insert(
            ignore,
            sprayPaint
        )

    end

    params.FilterDescendantsInstances =
        ignore

    params.RespectCanCollide =
        false

    local result =
        Workspace:Raycast(

            point
            + Selected.Normal
            * 0.75,

            -Selected.Normal
            * 2.25,

            params
        )

    if not result then
        return false
    end

    --------------------------------------------------
    -- SAME GENERAL SURFACE DIRECTION
    --------------------------------------------------

    if result.Normal
        :Dot(
            Selected.Normal
        ) < 0.85 then

        return false

    end

    --------------------------------------------------
    -- WALL SHOULD BE CLOSE TO OUR ART PLANE
    --------------------------------------------------

    local planeDistance =
        math.abs(

            (
                result.Position
                - point
            )
            :Dot(
                Selected.Normal
            )

        )

    if planeDistance
        > 0.45 then

        return false

    end

    return true

end

--------------------------------------------------
-- PREVIEW LINE
--------------------------------------------------

local function previewLine(
    a,
    b
)

    if not a
        or not b then

        return

    end

    local delta =
        b - a

    local length =
        delta.Magnitude

    if length
        < 0.001 then

        return

    end

    local line =
        Instance.new(
            "Part"
        )

    line.Name =
        "MSTJPreviewLine"

    line.Anchored =
        true

    line.CanCollide =
        false

    line.CanQuery =
        false

    line.CanTouch =
        false

    line.CastShadow =
        false

    line.Material =
        Enum.Material.Neon

    line.Color =
        PREVIEW_COLOR

    line.Transparency =
        0.18

    line.Size =
        Vector3.new(
            0.14
                * Scale,
            0.14
                * Scale,
            length
        )

    line.CFrame =
        CFrame.lookAt(
            (
                a + b
            ) / 2,
            b,
            Selected.Normal
        )

    line.Parent =
        PreviewFolder

end

--------------------------------------------------
-- UPDATE ART PREVIEW
--------------------------------------------------

local function updatePreview()

    PreviewFolder
        :ClearAllChildren()

    TransformInfo.Text =
        string.format(
            "Größe: %d%%     Rotation: %d°",
            math.floor(
                Scale * 100
            ),
            Rotation
        )

    if not Selected then
        return
    end

    for _,
        stroke
        in ipairs(ART) do

        for index = 1,
            #stroke - 1 do

            local pointA =
                stroke[index]

            local pointB =
                stroke[
                    index + 1
                ]

            local worldA =
                toWorld(
                    pointA[1],
                    pointA[2],
                    0.045
                )

            local worldB =
                toWorld(
                    pointB[1],
                    pointB[2],
                    0.045
                )

            previewLine(
                worldA,
                worldB
            )

        end

    end

end

