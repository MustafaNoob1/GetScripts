local function P(x, y)
    return {x, y}
end

local function copyPath(path, dx, dy)
    local out = {}
    for _, pt in ipairs(path) do
        table.insert(out, {pt[1] + dx, pt[2] + dy})
    end
    return out
end

local function addStroke(list, path, color, brushScale, layerOffset)
    table.insert(list, {
        points = path,
        color = color,
        brushScale = brushScale,
        layerOffset = layerOffset
    })
end

local function addCopies(list, path, offsets, color, brushScale, layerOffset)
    for _, off in ipairs(offsets) do
        addStroke(
            list,
            copyPath(path, off[1], off[2]),
            color,
            brushScale,
            layerOffset
        )
    end
end

