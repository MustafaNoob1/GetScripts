section(T.Files.WorldUI, "RELEVANT WORKSPACE INTERACTION OBJECTS")

local worldObjects = 0
local exposedConnections = 0

for index, object in ipairs(Workspace:GetDescendants()) do
    local blob = fullName(object) .. " " .. object.Name

    if interestingName(blob) then
        local supported = object:IsA("GuiButton")
            or object:IsA("ClickDetector")
            or object:IsA("ProximityPrompt")
            or object:IsA("BasePart")

        if supported then
            worldObjects += 1

            append(T.Files.WorldUI, "")
            append(
                T.Files.WorldUI,
                "OBJECT",
                worldObjects,
                object.ClassName,
                fullName(object),
                "ATTRS=" .. serialize(object:GetAttributes())
            )

            if type(getconnections) == "function" then
                local signals = {}

                if object:IsA("GuiButton") then
                    table.insert(signals, {"Activated", object.Activated})

                    pcall(function()
                        table.insert(
                            signals,
                            {"MouseButton1Click", object.MouseButton1Click}
                        )
                    end)

                elseif object:IsA("ClickDetector") then
                    table.insert(signals, {"MouseClick", object.MouseClick})

                elseif object:IsA("ProximityPrompt") then
                    table.insert(signals, {"Triggered", object.Triggered})
                end

                for _, signalInfo in ipairs(signals) do
                    local ok, connections = pcall(
                        getconnections,
                        signalInfo[2]
                    )

                    if ok and type(connections) == "table" then
                        append(
                            T.Files.WorldUI,
                            "SIGNAL",
                            signalInfo[1],
                            "count=" .. tostring(#connections)
                        )

                        for i, connection in ipairs(connections) do
                            local fn = nil

                            pcall(function()
                                fn = connection.Function
                            end)

                            if type(fn) == "function" then
                                exposedConnections += 1

                                dumpFunction(
                                    T.Files.WorldUI,
                                    fullName(object)
                                        .. "."
                                        .. signalInfo[1]
                                        .. "#"
                                        .. tostring(i),
                                    fn
                                )
                            end
                        end
                    end
                end
            end
        end
    end

    if index % 800 == 0 then
        task.wait()
    end
end

append(T.Files.Summary, "Relevant world interaction objects:", worldObjects)
append(T.Files.Summary, "Exposed world callbacks:", exposedConnections)

--------------------------------------------------
-- PASSIVE REMOTE TRACE
--------------------------------------------------

section(T.Files.Remotes, "PASSIVE OUTBOUND REMOTE TRACE")
append(
    T.Files.Remotes,
    "Only calls made by the GAME while tracing are logged."
)

local remoteFolder = ReplicatedStorage:FindFirstChild("Remotes")
local targetInstances = {}

if remoteFolder then
    for _, object in ipairs(remoteFolder:GetChildren()) do
        if T.TargetRemoteNames[object.Name]
            and (
                object:IsA("RemoteEvent")
                or object:IsA("RemoteFunction")
            ) then

            targetInstances[object] = true

            append(
                T.Files.Remotes,
                "WATCH",
                object.ClassName,
                fullName(object)
            )
        end
    end
end

local function callingScriptText()
    if type(getcallingscript) == "function" then
        local ok, scriptInst = pcall(getcallingscript)

        if ok and scriptInst then
            return fullName(scriptInst)
        end
    end

    return "unknown"
end

local function logRemote(remote, method, args)
    append(
        T.Files.Remotes,
        "",
        "[" .. now() .. "]",
        method,
        fullName(remote),
        "caller=" .. callingScriptText(),
        "argc=" .. tostring(args.n or #args)
    )

    for i = 1, (args.n or #args) do
        append(
            T.Files.Remotes,
            "ARG",
            i,
            "=",
            clip(serialize(args[i]), 30000)
        )
    end
end

T.HookInstalled = false

if type(hookmetamethod) == "function"
    and type(getnamecallmethod) == "function"
    and type(newcclosure) == "function" then

    local oldNamecall

    oldNamecall = hookmetamethod(
        game,
        "__namecall",
        newcclosure(function(self, ...)
            local method = getnamecallmethod()

            if T.Enabled
                and targetInstances[self]
                and (
                    method == "FireServer"
                    or method == "InvokeServer"
                ) then

                local args = table.pack(...)

                pcall(function()
                    logRemote(self, method, args)
                end)
            end

            return oldNamecall(self, ...)
        end)
    )

    T.HookInstalled = true

    append(
        T.Files.Summary,
        "Passive namecall trace:",
        "installed"
    )
else
    append(
        T.Files.Summary,
        "Passive namecall trace:",
        "UNAVAILABLE"
    )
end

--------------------------------------------------
-- CONTROL
--------------------------------------------------

function T:Mark(label)
    append(
        self.Files.Remotes,
        "",
        "[" .. now() .. "] MARK",
        tostring(label or "manual")
    )
end

function T:Stop()
    if not self.Enabled then
        return
    end

    self.Enabled = false

    section(self.Files.Summary, "FINAL")
    append(self.Files.Summary, "Stopped UTC:", now())
    append(
        self.Files.Summary,
        "Runtime seconds:",
        string.format("%.2f", os.clock() - self.Started)
    )
    append(
        self.Files.Summary,
        "Hook installed:",
        tostring(self.HookInstalled)
    )

    warn("[AutoTrace] STOPPED")
    warn("[AutoTrace] Upload AUTO_TRACE_*.txt files.")
end

