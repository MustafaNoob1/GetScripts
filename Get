function BR.statsText()
    local stats = BR.Stats

    if not stats then
        return "Player stats: not detected yet"
    end

    local parts = {}

    for _, key in ipairs(BR.StatKeys) do
        if tonumber(stats[key]) then
            table.insert(parts, key .. "=" .. BR.short(stats[key]))
        end
    end

    local money = BR.currentMoney()
    local moneyText = money ~= nil
        and (BR.short(money) .. " (" .. tostring(BR.MoneySource) .. ")")
        or "unknown"

    BR.refreshCareerMeta()
    BR.findScoutEstimate()

    local potentialText = BR.ActualPotential ~= nil
        and (BR.short(BR.ActualPotential) .. " [" .. tostring(BR.PotentialSource) .. "]")
        or "hidden / not detected"

    local scoutText = (
        BR.ScoutEstimateLow ~= nil and BR.ScoutEstimateHigh ~= nil
    )
        and (
            tostring(BR.ScoutEstimateLow)
            .. "-"
            .. tostring(BR.ScoutEstimateHigh)
        )
        or "not visible"

    return "Player stats: " .. table.concat(parts, " | ")
        .. "\nMoney: " .. moneyText
        .. "\nOverall: " .. tostring(BR.CurrentOverall or "-")
        .. " | Reputation: " .. tostring(BR.CurrentReputation or "-")
        .. " | Age: " .. tostring(BR.CurrentAge or "-")
        .. "\nTRUE Potential: " .. potentialText
        .. "\nScout estimate: " .. scoutText
end

function BR.bestText(best)
    local info = BR.LastScanInfo or {}

    if not best then
        local eventTitle = info.Event and info.Event.title or "-"

        return "Event: " .. tostring(eventTitle)
            .. "\nNo clickable known choice right now."
            .. "\nKnown: " .. tostring(info.Known or 0)
            .. " | affordable: " .. tostring(info.Affordable or 0)
            .. " | too expensive: " .. tostring(info.Unaffordable or 0)
            .. " | disabled: " .. tostring(info.Disabled or 0)
            .. " | retry-blocked: " .. tostring(info.Blocked or 0)
            .. "\nMoney: " .. tostring(
                BR.currentMoney() ~= nil
                    and BR.short(BR.currentMoney())
                    or "unknown"
            )
    end

    local eventTitle = "-"
    if best.Event and best.Event.title then
        eventTitle = tostring(best.Event.title)
    end

    local text =
        "Event: " .. eventTitle
        .. "\nBest: " .. tostring(best.Choice.text or best.Text)
        .. "\nCost: " .. (
            (tonumber(best.Cost) or 0) > 0
                and BR.short(best.Cost)
                or "FREE"
        )
        .. " | Money: " .. (
            best.Money ~= nil
                and BR.short(best.Money)
                or "unknown"
        )
        .. "\nWorst rating: " .. string.format("%+.2f", best.WorstRating or 0)
        .. " | Expected: " .. string.format("%+.2f", best.ExpectedRating or 0)
        .. " | Best: " .. string.format("%+.2f", best.BestRating or 0)
        .. "\nNo-minus chance: "
        .. tostring(math.floor((best.SafeProbability or 0) * 100 + 0.5))
        .. "%"
        .. "\nOptimizer Score: " .. string.format("%.1f", best.Score or 0)

    if best.Chance then
        text = text
            .. "\nRoll Chance: " .. tostring(math.floor(best.Chance)) .. "%"
    end

    if BR.RiskMode == "Never Minus"
        and (best.WorstRating or 0) < 0 then
        text = text
            .. "\nWARNING: this event has no safer evaluated option; rating loss is possible."
    end

    return text
end

function BR.identityText()
    local best = BR.bestIdentity()

    if not best then
        return "Position: not detected. Set Position manually if needed."
    end

    local identity = best.Identity
    local perks = identity.perks or {}

    return "Position: " .. tostring(best.Position)
        .. "\nBest direct-rating identity: " .. tostring(identity.name)
        .. "\nRating perk: +" .. string.format("%.2f", best.Rating or 0)
        .. "\nGoals perk: " .. tostring(perks.goals or 0)
        .. " | Assists: " .. tostring(perks.assists or 0)
        .. " | Clean sheets: " .. tostring(perks.cs or 0)
end

