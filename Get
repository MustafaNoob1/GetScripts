-- AutoLoop ONLY V2 | scanned game (no auto-buy, no currency edits)
-- Auto-triggers the normal LoopEvent when the live Level reaches the next
-- loop requirement. Uses a reply-check/backoff instead of spamming requests.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

if not player then
    warn("[AutoLoop] LocalPlayer unavailable")
    return
end

local env = (type(getgenv) == "function" and getgenv()) or _G
if type(env.AutoLoop) == "table" and type(env.AutoLoop.Unload) == "function" then
    pcall(function() env.AutoLoop:Unload() end)
end

local B = {
    Alive = true,
    Enabled = true,
    CheckInterval = 0.35,
    AckTimeout = 3.0,
    RetryDelay = 7.0,
    Cooldown = 0.65,
    LastSend = -math.huge,
    LastLoopValue = nil,
    LastLevelValue = nil,
    NextRequiredLevel = nil,
    SendCount = 0,
    ConfirmedCount = 0,
    StatusText = "Starte...",
    Pending = false,
    PendingOldLoops = nil,
    PendingAt = 0,
    BlockUntil = 0,
    GUI = nil,
}
env.AutoLoop = B

local values = player:WaitForChild("Values", 15)
local remotes = RS:WaitForChild("Remotes", 15)
local remote = remotes and remotes:FindFirstChild("LoopEvent")

if not values or not remote or not remote:IsA("RemoteEvent") then
    warn("[AutoLoop] Values or ReplicatedStorage.Remotes.LoopEvent missing")
    B.StatusText = "Fehler: Values / LoopEvent fehlt"
    B.Alive = false
    return
end

local formulas, config, EN
pcall(function()
    formulas = require(RS:WaitForChild("Shared"):WaitForChild("Formulas"))
end)
pcall(function()
    config = require(RS.Shared.Config.GameConfig)
end)
pcall(function()
    EN = require(RS.Shared.Libs.EternityNum)
end)

local function parseNumber(value)
    if type(value) == "number" then
        if value == value then return value end
        return nil
    end
    if type(value) == "table" and EN then
        local ok, numeric = pcall(function()
            return EN.toNumber(value)
        end)
        if ok and type(numeric) == "number" and numeric == numeric then
            return numeric
        end
    end
    if type(value) == "string" then
        -- This game replicates numbers as "layer;magnitude", e.g. "0;32".
        local layer, magnitude = value:match("^%s*([^;]+)%s*;%s*(.-)%s*$")
        layer, magnitude = tonumber(layer), tonumber(magnitude)
        if layer ~= nil and magnitude ~= nil then
            if layer == 0 then return magnitude end
            if layer > 0 then return math.huge end  -- larger than any regular level target
            return 0
        end
        return tonumber(value)
    end
    return nil
end

local function getValue(name)
    local obj = values:FindFirstChild(name)
    if not obj then return nil end
    if obj:IsA("ValueBase") then
        return parseNumber(obj.Value)
    end
    return nil
end

local function defaultRequirement(loops)
    local base = 100
    if type(config) == "table" and type(config.Thresholds) == "table" then
        base = tonumber(config.Thresholds.LoopLevelsPerLoop) or base
    end
    return base * (loops + 1)
end

local function getRequirement(loops)
    local expected = defaultRequirement(loops)
    if type(formulas) ~= "table" or type(formulas.LoopRequirement) ~= "function" then
        return expected, "config"
    end
    -- Prefer the game's exact formula, but reject implausible results from a
    -- mismatched argument type. The scanner confirms 100 levels per loop.
    local inputs = {loops, tostring(loops), "0;" .. tostring(loops)}
    for _, input in ipairs(inputs) do
        local ok, value = pcall(formulas.LoopRequirement, input)
        if ok then
            local n = parseNumber(value)
            if n and n >= expected * 0.8 and n <= expected * 1.2 then
                return n, "formula"
            end
        end
    end
    return expected, "config"
end

local function updateSnapshot()
    local loops = getValue("Loops")
    -- Level can be a replicated child of Values or (depending on game build)
    -- a direct player value. We do not confuse StarLevels with Level.
    local level = getValue("Level")
    if level == nil then
        local other = player:FindFirstChild("Level")
        if other and other:IsA("ValueBase") then
            level = parseNumber(other.Value)
        end
    end
    B.LastLoopValue = loops
    B.LastLevelValue = level
    if loops == nil then
        B.StatusText = "Warte auf Values.Loops"
        return nil, nil
    end
    if level == nil then
        B.StatusText = "Warte auf Level (Values.Level)"
        return loops, nil
    end
    if loops < 0 or loops == math.huge then
        B.StatusText = "Ungueltiger Loop-Wert"
        return nil, nil
    end
    local target, source = getRequirement(loops)
    B.NextRequiredLevel = target
    B.RequirementSource = source
    B.StatusText = string.format("Loops %s | Level %s/%s", tostring(loops), tostring(level), tostring(target))
    return loops, level, target
end

local function buildGui()
    local pg = player:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    local old = pg:FindFirstChild("AutoLoopOnlyV2")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "AutoLoopOnlyV2"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = false
    gui.DisplayOrder = 650
    gui.Parent = pg
    B.GUI = gui

    local card = Instance.new("Frame")
    card.Size = UDim2.fromOffset(286, 108)
    card.Position = UDim2.new(1, -305, 0, 65)
    card.BackgroundColor3 = Color3.fromRGB(23, 25, 34)
    card.BorderSizePixel = 0
    card.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 9)
    corner.Parent = card

    local head = Instance.new("TextLabel")
    head.BackgroundTransparency = 1
    head.Position = UDim2.fromOffset(10, 7)
    head.Size = UDim2.new(1, -110, 0, 23)
    head.Text = "AUTO LOOP ONLY V2"
    head.Font = Enum.Font.GothamBold
    head.TextSize = 13
    head.TextColor3 = Color3.fromRGB(235, 239, 250)
    head.TextXAlignment = Enum.TextXAlignment.Left
    head.Parent = card

    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Position = UDim2.fromOffset(10, 36)
    status.Size = UDim2.new(1, -18, 0, 63)
    status.Text = "Warte auf Spielwerte ..."
    status.Font = Enum.Font.Code
    status.TextSize = 12
    status.TextWrapped = true
    status.TextColor3 = Color3.fromRGB(185, 195, 211)
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.TextYAlignment = Enum.TextYAlignment.Top
    status.Parent = card

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.fromOffset(91, 26)
    toggle.Position = UDim2.new(1, -100, 0, 7)
    toggle.BorderSizePixel = 0
    toggle.Font = Enum.Font.GothamBold
    toggle.TextSize = 12
    toggle.TextColor3 = Color3.new(1, 1, 1)
    toggle.Parent = card
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 6)
    toggleCorner.Parent = toggle

    local function refresh()
        toggle.Text = B.Enabled and "ON" or "OFF"
        toggle.BackgroundColor3 = B.Enabled
            and Color3.fromRGB(28, 132, 94)
            or Color3.fromRGB(133, 49, 53)
        status.Text = (B.StatusText or "-")
            .. "\nEvents: " .. tostring(B.SendCount)
            .. " | bestaetigt: " .. tostring(B.ConfirmedCount)
            .. (B.Pending and " | wartet..." or "")
    end

    toggle.MouseButton1Click:Connect(function()
        B.Enabled = not B.Enabled
        B.Pending = false
        B.BlockUntil = 0
        refresh()
    end)
    B.UpdateGUI = refresh
    refresh()
end

pcall(buildGui)

function B:Status()
    updateSnapshot()
    local message = "[AutoLoop] " .. (self.StatusText or "-")
        .. " | Enabled=" .. tostring(self.Enabled)
        .. " | Events=" .. tostring(self.SendCount)
        .. " | Confirmed=" .. tostring(self.ConfirmedCount)
        .. " | Source=" .. tostring(self.RequirementSource)
    print(message)
    return message
end
function B:Stop()
    self.Enabled = false
    self.Pending = false
    self.StatusText = "Pausiert"
    if self.UpdateGUI then pcall(self.UpdateGUI) end
end
function B:Start()
    self.Enabled = true
    self.Pending = false
    self.BlockUntil = 0
end
function B:Unload()
    self.Alive = false
    self.Enabled = false
    if self.GUI then pcall(function() self.GUI:Destroy() end) end
    self.GUI = nil
end

task.spawn(function()
    while B.Alive do
        local ok, err = pcall(function()
            local loops, level, required = updateSnapshot()
            if not B.Enabled then
                B.StatusText = "Pausiert | " .. (B.StatusText or "")
                return
            end
            if not (loops and level and required) then return end
            if B.Pending then
                if loops > (B.PendingOldLoops or loops) then
                    B.ConfirmedCount = B.ConfirmedCount + 1
                    B.Pending = false
                    B.BlockUntil = os.clock() + 0.6
                    B.StatusText = "LOOP BESTAETIGT! Loops=" .. tostring(loops)
                    warn("[AutoLoop] Confirmed loop increase: " .. tostring(loops))
                elseif os.clock() - B.PendingAt >= B.AckTimeout then
                    -- Failed/no response: back off before attempting again.
                    B.Pending = false
                    B.BlockUntil = os.clock() + B.RetryDelay
                    B.StatusText = "Keine Bestaetigung; erneuter Versuch spaeter"
                end
                return
            end
            if level < required or os.clock() < B.BlockUntil then return end
            if os.clock() - B.LastSend < B.Cooldown then return end
            B.LastSend = os.clock()
            B.Pending = true
            B.PendingOldLoops = loops
            B.PendingAt = os.clock()
            -- Reset is calculated and validated by the game's normal server handler.
            -- The scan confirms this RemoteEvent is the loop trigger; the trace
            -- did not establish any additional payload fields.
            remote:FireServer()
            B.SendCount = B.SendCount + 1
            B.StatusText = "LoopEvent gesendet; warte auf Loops-Anstieg"
            warn("[AutoLoop] LoopEvent sent at level=" .. tostring(level) .. " loops=" .. tostring(loops))
        end)
        if not ok then
            B.StatusText = "Fehler: " .. tostring(err)
            B.Pending = false
            B.BlockUntil = os.clock() + B.RetryDelay
        end
        if B.UpdateGUI then pcall(B.UpdateGUI) end
        task.wait(B.CheckInterval)
    end
end)

warn("[AutoLoop] V2 ready | no purchase automation | use getgenv().AutoLoop:Status()")

