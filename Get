-- POINT HELPERS
------------------------------------------------------------

local function P(
    x,
    y
)

    return {
        x,
        y
    }

end


local function shift(
    path,
    dx,
    dy
)

    local new =
        {}

    for _,
        p in ipairs(path) do

        table.insert(
            new,
            {
                p[1] + dx,
                p[2] + dy
            }
        )

    end

    return new

end


