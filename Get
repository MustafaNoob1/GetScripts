stage("5/5 Mapping direct remote references")

section(M.Files.RemoteRefs, "REMOTE REFERENCES FROM GC FUNCTIONS")

local remotes = {}
local remoteByInstance = {}

for _, object in ipairs(ReplicatedStorage:GetDescendants()) do
    if object:IsA("RemoteEvent")
        or object:IsA("RemoteFunction")
        or object.ClassName == "UnreliableRemoteEvent" then

        table.insert(remotes, object)
        remoteByInstance[object] = true
    end
end

for i, remote in ipairs(remotes) do
    append(
        M.Files.RemoteRefs,
        "REMOTE",
        i,
        remote.ClassName,
        fullName(remote)
    )
end

local function tableContainsRemote(tbl, depth, seen)
    depth = depth or 0
    seen = seen or {}

    if depth > 3 or type(tbl) ~= "table" or seen[tbl] then
        return nil
    end
    seen[tbl] = true

    for k, v in pairs(tbl) do
        if typeof(v) == "Instance" and remoteByInstance[v] then
            return v
        elseif type(v) == "table" then
            local found = tableContainsRemote(
                v,
                depth + 1,
                seen
            )
            if found then
                return found
            end
        end

        if typeof(k) == "Instance" and remoteByInstance[k] then
            return k
        end
    end

    return nil
end

local mapped = 0

if type(getgc) == "function" then
    local ok, objects = pcall(getgc, true)

    if ok and type(objects) == "table" then
        for index, object in ipairs(objects) do
            if type(object) == "function"
                and type(getupvalues) == "function" then

                local okUp, upvalues = pcall(
                    getupvalues,
                    object
                )

                if okUp and type(upvalues) == "table" then
                    local foundRemote = nil

                    for _, value in pairs(upvalues) do
                        if typeof(value) == "Instance"
                            and remoteByInstance[value] then
                            foundRemote = value
                            break
                        elseif type(value) == "table" then
                            foundRemote = tableContainsRemote(
                                value,
                                0,
                                {}
                            )
                            if foundRemote then break end
                        end
                    end

                    if foundRemote then
                        mapped += 1
                        append(M.Files.RemoteRefs, "")
                        append(
                            M.Files.RemoteRefs,
                            "REMOTE_REF_FUNCTION",
                            mapped,
                            "remote=" .. fullName(foundRemote)
                        )

                        dumpFunction(
                            M.Files.RemoteRefs,
                            "gc#" .. tostring(index),
                            object
                        )
                    end
                end
            end

            if index % 350 == 0 then
                task.wait()
            end
        end
    end
end

append(M.Files.Summary, "GC functions with direct remote refs:", mapped)

