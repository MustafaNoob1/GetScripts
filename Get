------------------------------------------------------------
-- PREVIEW
------------------------------------------------------------

local function previewSegment(
    a,
    b,
    color,
    thickness
)

    local difference =
        b - a

    local length =
        difference.Magnitude

    if length < 0.001 then
        return
    end

    local part =
        Instance.new("Part")

    part.Name =
        "MSTIPreview"

    part.Anchored =
        true

    part.CanCollide =
        false

    part.CanQuery =
        false

    part.CanTouch =
        false

    part.CastShadow =
        false

    part.Material =
        Enum.Material.Neon

    part.Color =
        color

    part.Transparency =
        0.15

    part.Size =
        Vector3.new(
            thickness,
            thickness,
            length
        )

    part.CFrame =
        CFrame.lookAt(
            (
                a + b
            ) / 2,
            b,
            Selected.Normal
        )

    part.Parent =
        PreviewFolder

end


------------------------------------------------------------
-- RESOLVE MATERIAL
------------------------------------------------------------

local function resolveMaterial(
    style
)

    local material =
        style.Material

    if type(material)
        == "function" then

        return material()

    end

    return material

end


------------------------------------------------------------
-- PREVIEW UPDATE
------------------------------------------------------------

local function updatePreview()

    PreviewFolder
        :ClearAllChildren()

    TransformInfo.Text =
        string.format(
            "Größe: %d%%     Rotation: %d°",
            math.floor(
                Scale * 100
            ),
            Rotation
        )

    updateFeatureInfo()

    if not Selected then
        return
    end

    for _,
        strokeData in ipairs(
            DESIGN
        ) do

        local style =
            STYLE[
                strokeData.Style
            ]

        local thickness =
            BASE_BRUSH
            * style.Brush
            * strokeData.BrushMultiplier
            * Scale
            * 0.46

        thickness =
            math.max(
                thickness,
                0.035
            )

        local points =
            strokeData.Points

        for i = 1,
            #points - 1 do

            local a =
                points[i]

            local b =
                points[
                    i + 1
                ]

            previewSegment(

                toWorld(
                    a[1],
                    a[2],
                    0.045
                ),

                toWorld(
                    b[1],
                    b[2],
                    0.045
                ),

                style.Color,

                thickness

            )

        end

    end

end


