-- Career-state discovery.
S.StateKeys = {
    "name","age","season","seasons","position","pos","ovr","overall","gen","peak","peakOverall","careerPeak",
    "pot","potential","truePotential","potMin","potMax","scoutsUnsure","money","rep","reputation","forme","moral",
    "discipline","charisme","tir","passe","dribble","vitesse","puissance","defense","mental","xp","club","contract",
    "playstyle","staff","staffs","staffOwned","injury","injured","suspend","goals","assists","buts","passes","caps",
    "selections","matches","j","ballons","wc","ucl","trophies","palmares","totals"
}
function S.stateScore(t)
    if type(t) ~= "table" then return 0 end
    local s = 0
    for _, k in ipairs(S.StateKeys) do if rawget(t,k) ~= nil then s += 1 end end
    for _, k in ipairs({"tir","passe","dribble","vitesse","puissance","defense","mental"}) do
        local v = tonumber(rawget(t,k)); if v and v>=0 and v<=250 then s += 2 end
    end
    if rawget(t,"position")~=nil then s+=4 end
    if rawget(t,"club")~=nil then s+=4 end
    if rawget(t,"contract")~=nil then s+=4 end
    if rawget(t,"potMin")~=nil then s+=5 end
    if rawget(t,"potMax")~=nil then s+=5 end
    if rawget(t,"money")~=nil then s+=4 end
    if rawget(t,"age")~=nil then s+=4 end
    return s
end
function S.findStates(maxn)
    local out = {}
    if type(getgc) ~= "function" then return out end
    local ok, arr = pcall(getgc, true)
    if not ok or type(arr)~="table" then return out end
    for _, o in ipairs(arr) do
        if type(o)=="table" then
            local sc = S.stateScore(o)
            if sc >= 12 then table.insert(out,{Score=sc,Table=o}) end
        end
    end
    table.sort(out,function(a,b) return a.Score>b.Score end)
    while #out > (maxn or 12) do table.remove(out) end
    return out
end
function S.shallowState(t)
    local out = {}
    if type(t)~="table" then return out end
    for _, k in ipairs(S.StateKeys) do
        local v = rawget(t,k)
        if v ~= nil then
            if type(v)=="table" then
                if k=="club" or k=="contract" or k=="totals" or k=="staff" or k=="staffs" or k=="staffOwned" then out[k]=v else out[k]="<table>" end
            else out[k]=v end
        end
    end
    return out
end
function S.bestState()
    local a = S.findStates(5)
    return a[1] and a[1].Table or nil, a[1] and a[1].Score or 0, a
end
