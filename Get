log("====================================")
log("REMOTE EVENTS / FUNCTIONS")
log("====================================")

local remoteCount = 0

for _, obj in ipairs(game:GetDescendants()) do

    local class = obj.ClassName

    if
        class == "RemoteEvent"
        or class == "RemoteFunction"
        or class == "UnreliableRemoteEvent"
    then

        remoteCount += 1

        local interesting =
            nameInteresting(obj.Name)

        if interesting then

            log(
                "[REMOTE *]",
                class,
                obj:GetFullName()
            )

        else

            log(
                "[REMOTE]",
                class,
                obj:GetFullName()
            )

        end
    end
end

