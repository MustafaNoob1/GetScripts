--------------------------------------------------
-- WORLD CLICK
--------------------------------------------------

UserInputService.InputBegan:Connect(
    function(input, processed)

        if processed then
            return
        end

        if not SelectMode then
            return
        end

        if input.UserInputType
            ~= Enum.UserInputType.MouseButton1 then
            return
        end

        local result =
            raycastMouse()

        if not result then

            Status.Text =
                "Keine Oberfläche getroffen"

            return
        end

        local right, up =
            makeBasis(
                result.Normal
            )

        Selected = {

            Position =
                result.Position,

            Normal =
                result.Normal.Unit,

            Right =
                right,

            Up =
                up,

            Part =
                result.Instance

        }

        SelectMode = false

        updatePreview()

        Status.Text =
            "✓ Position gespeichert\n"
            .. result.Instance.Name

        Status.TextColor3 =
            Color3.fromRGB(
                100,
                255,
                140
            )

        print(
            "[MSTJ] WALL SELECTED"
        )

        print(
            "Part:",
            Selected.Part:GetFullName()
        )

        print(
            "Position:",
            Selected.Position
        )

        print(
            "Normal:",
            Selected.Normal
        )

    end
)

