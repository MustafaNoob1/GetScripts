function BR.click(button)
    if not button or not BR.isActuallyVisible(button) then
        return false
    end

    -- Executor-native signal click when available.
    if type(firesignal) == "function" then
        local ok = pcall(function()
            firesignal(button.Activated)
        end)

        if ok then
            return true
        end
    end

    -- Roblox input fallback.
    local position = button.AbsolutePosition
    local size = button.AbsoluteSize
    local x = position.X + size.X / 2
    local y = position.Y + size.Y / 2

    local ok = pcall(function()
        BR.VirtualInputManager:SendMouseButtonEvent(
            x,
            y,
            0,
            true,
            game,
            0
        )

        task.wait(0.04)

        BR.VirtualInputManager:SendMouseButtonEvent(
            x,
            y,
            0,
            false,
            game,
            0
        )
    end)

    return ok
end

function BR.tryChoice(best)
    if not best or not best.Button then
        return false, "no choice"
    end

    if os.clock() < (BR.ClickLockUntil or 0) then
        return false, "click cooldown"
    end

    local affordable, _, reason = BR.choiceAffordable(best.Choice)
    if not affordable then
        BR.BlockedChoiceUntil[best.Key] = os.clock() + 5
        return false, reason or "unaffordable"
    end

    local interactable, disabledReason = BR.buttonInteractable(best.Button)
    if not interactable then
        return false, disabledReason or "disabled"
    end

    BR.LastClickButton = best.Button
    BR.LastClickAt = os.clock()
    BR.ClickLockUntil = os.clock() + 1.25

    local button = best.Button
    local key = best.Key
    local eventId = best.Event and best.Event.id
    local ok = BR.click(button)

    if ok then
        -- If the same enabled choice is still sitting there after the click,
        -- the game most likely rejected it (typically insufficient money or
        -- another requirement). Temporarily blacklist it so the next-best
        -- valid choice can be selected instead of spamming the same button.
        task.delay(1.35, function()
            if not BR.Alive then
                return
            end

            local stillVisible =
                button
                and button.Parent
                and BR.isActuallyVisible(button)

            local stillInteractable = false
            if stillVisible then
                stillInteractable = BR.buttonInteractable(button)
            end

            local sameEvent = true
            if eventId then
                local current = BR.currentVisibleEvent()
                sameEvent = current and current.id == eventId
            end

            if stillVisible and stillInteractable and sameEvent then
                BR.BlockedChoiceUntil[key] = os.clock() + 6

                pcall(function()
                    BR.Fluent:Notify({
                        Title = "Choice rejected",
                        Content = "Skipping this option temporarily and trying the next valid one.",
                        Duration = 3
                    })
                end)
            end
        end)
    end

    return ok, ok and nil or "click failed"
end

