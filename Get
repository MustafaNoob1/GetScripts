------------------------------------------------------------
-- VALIDATE
------------------------------------------------------------

local function validate()

    if not Selected then

        return false,
            "Erst eine Wand auswählen."

    end

    if not Selected.Part
        or not Selected.Part.Parent then

        return false,
            "Wand existiert nicht mehr."

    end

    local root =
        getRoot()

    if not root then

        return false,
            "Character nicht gefunden."

    end

    local distance =
        (
            root.Position
            - Selected.Position
        ).Magnitude

    if distance >= MAX_RANGE then

        return false,
            "Zu weit von der Wand entfernt."

    end

    return true

end


------------------------------------------------------------
-- APPEARANCE
------------------------------------------------------------

local function makeAppearance(
    strokeData
)

    local style =
        STYLE[
            strokeData.Style
        ]

    local brush =
        BASE_BRUSH
        * style.Brush
        * strokeData.BrushMultiplier
        * Scale

    brush =
        math.clamp(
            brush,
            0.05,
            3.5
        )

    return {

        BrushSize =
            brush,

        PaintLayer =
            internalLayer(
                style.Layer
            ),

        Opacity =
            1,

        Color =
            style.Color,

        Material =
            resolveMaterial(
                style
            ),

        Owner =
            Player

    }

end


