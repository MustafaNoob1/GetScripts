-- GOAT Research Scanner V2 LITE
-- Designed to run alongside BestRatingOptimizer_V6_GOAT_MAX.
--
-- This version intentionally avoids the heavy operations that can freeze/crash
-- mobile executors:
--   * no decompile loop
--   * no getconstants/proto scan
--   * no listener on every RemoteEvent
--   * no full PlayerGui dump every 0.45s
--   * no getgc() every frame
--
-- Output:
--   GOATScan_LiteTelemetry.txt
--   GOATScan_LiteSummary.txt

local S = {}
getgenv().GOATResearchScanner = S

S.Alive = true
S.StartedAt = os.time()
S.Lines = {}
S.MaxLines = 12000
S.LastFlush = 0
S.FlushEvery = 12
S.PollEvery = 1.10

S.LastStateFP = ""
S.LastDecisionFP = ""
S.LastPolicyFP = ""
S.LastEventFP = ""
S.LastCareerRefScan = -math.huge
S.CareerState = nil
S.CareerStateScore = 0

S.EventCounts = {}
S.ChoiceCounts = {}
S.PolicyCounts = {}
S.MinOverall = nil
S.MaxOverall = nil
S.MaxPeak = nil
S.StartOverall = nil
S.EndOverall = nil
S.StartAge = nil
S.EndAge = nil

S.Players = game:GetService("Players")
S.RS = game:GetService("ReplicatedStorage")
S.Player = S.Players.LocalPlayer
S.Gui = S.Player:WaitForChild("PlayerGui")
S.DayFoot = S.RS:FindFirstChild("DayFoot")

--------------------------------------------------
-- HELPERS
--------------------------------------------------

function S.norm(value)
    local s = string.lower(tostring(value or ""))
    s = s:gsub("’", "'")
        :gsub("“", '"')
        :gsub("”", '"')
        :gsub("–", "-")
        :gsub("—", "-")
        :gsub("<.->", " ")
        :gsub("%s+", " ")
        :gsub("^%s+", "")
        :gsub("%s+$", "")
    return s
end

function S.ts()
    return os.date("!%Y-%m-%dT%H:%M:%SZ")
end

function S.clip(value, maxLen)
    local s = tostring(value or "")
    maxLen = maxLen or 600
    if #s > maxLen then
        return s:sub(1, maxLen) .. "...<truncated>"
    end
    return s
end

function S.path(inst)
    local ok, value = pcall(function()
        return inst:GetFullName()
    end)
    return ok and tostring(value) or tostring(inst)
end

function S.serializeFlat(tbl, keys)
    if type(tbl) ~= "table" then
        return "none"
    end

    local parts = {}

    for _, key in ipairs(keys) do
        local value = rawget(tbl, key)

        if value ~= nil and type(value) ~= "table" then
            table.insert(parts, tostring(key) .. "=" .. S.clip(value, 180))
        end
    end

    return table.concat(parts, " | ")
end

function S.write(name, data)
    if type(writefile) ~= "function" then
        return false
    end

    local ok, err = pcall(function()
        writefile(name, tostring(data or ""))
    end)

    if not ok then
        warn("[GOATScanner] write failed:", name, err)
    end

    return ok
end

function S.log(kind, message)
    local line =
        "[" .. S.ts() .. "]"
        .. "[" .. tostring(kind or "INFO") .. "] "
        .. tostring(message or "")

    table.insert(S.Lines, line)

    if #S.Lines > S.MaxLines then
        -- Keep only recent telemetry instead of growing without bound.
        local keep = {}
        local startIndex = math.floor(#S.Lines * 0.40)

        for i = startIndex, #S.Lines do
            table.insert(keep, S.Lines[i])
        end

        S.Lines = keep
    end
end

function S.flush()
    S.write(
        "GOATScan_LiteTelemetry.txt",
        table.concat(S.Lines, "\n")
    )

    S.LastFlush = os.clock()
end

--------------------------------------------------
-- EVENT INDEX (SMALL / SAFE)
--------------------------------------------------

S.Events = nil
S.EventTitles = {}
S.ChoiceTexts = {}

if S.DayFoot then
    local eventsModule = S.DayFoot:FindFirstChild("Events")

    if eventsModule and eventsModule:IsA("ModuleScript") then
        pcall(function()
            S.Events = require(eventsModule)
        end)
    end
end

function S.indexEvents(node, seen)
    if type(node) ~= "table" then
        return
    end

    seen = seen or {}
    if seen[node] then
        return
    end
    seen[node] = true

    if type(node.id) == "string"
        and type(node.title) == "string"
        and type(node.choices) == "table" then

        S.EventTitles[S.norm(node.title)] = node

        for index, choice in ipairs(node.choices) do
            if type(choice) == "table"
                and type(choice.text) == "string" then

                local key = S.norm(choice.text)
                S.ChoiceTexts[key] = S.ChoiceTexts[key] or {}

                table.insert(S.ChoiceTexts[key], {
                    Event = node,
                    Choice = choice,
                    Index = index
                })
            end
        end
    end

    for key, value in pairs(node) do
        if type(value) == "table" and key ~= "choices" then
            S.indexEvents(value, seen)
        end
    end
end

if S.Events then
    S.indexEvents(S.Events, {})
end

